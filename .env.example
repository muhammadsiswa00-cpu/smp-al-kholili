# Konfigurasi Koneksi Database Turso (libSQL)
# Dapatkan URL dan Auth Token dari Dashboard Turso (https://turso.tech) atau lewat terminal: `turso db show <nama-db>` dan `turso db tokens create <nama-db>`

TURSO_DATABASE_URL=libsql://nama-database-anda.turso.io
TURSO_AUTH_TOKEN=eyJh...token-rahasia-anda
