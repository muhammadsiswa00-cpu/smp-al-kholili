---

<Layout 
  title="Prestasi Siswa - SMP Islam Al-Kholili Probolinggo"
  description="Kumpulan prestasi akademik, tahfidzul qur'an, seni hadrah, dan kejuaraan non-akademik siswa-siswi SMP Islam Al-Kholili Kota Probolinggo berprestasi."
  currentPage="prestasi"
>
  <!-- Page Header Banner -->
  <section class="bg-gradient-to-r from-brand-950 via-brand-900 to-emerald-900 text-white py-14 border-b border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-gold-400 uppercase tracking-widest mb-2">
          <i class="fa-solid fa-trophy"></i> Prestasi Sekolah
        </div>
        <h1 class="text-3xl sm:text-4xl font-heading font-extrabold tracking-tight">Prestasi Siswa-Siswi</h1>
        <p class="text-emerald-200 text-sm mt-2 max-w-xl">
          Bukti nyata dedikasi santri-pelajar dan bimbingan guru dalam mengukir karya gemilang di berbagai ajang kompetisi.
        </p>
      </div>
      <div class="flex items-center gap-2 text-xs text-slate-300 bg-white/10 px-4 py-2 rounded-lg backdrop-blur-sm">
        <a href="/" class="hover:text-white transition">Beranda</a>
        <span>/</span>
        <span class="text-gold-400 font-semibold">Prestasi</span>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-700 bg-brand-50 px-3.5 py-1.5 rounded-full">
          Kebanggaan Al-Kholili
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-slate-900 mt-2">
          Jejak Prestasi Terkini
        </h2>
        <p class="text-slate-500 text-sm mt-1">Mengasah potensi fitrah santri menuju generasi berilmu dan bertakwa.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {achievements.map((item) => (
          <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover-card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class={`px-3 py-1 rounded-full text-xs font-extrabold border ${item.badge}`}>
                  <i class="fa-solid fa-trophy mr-1 text-gold-500"></i> {item.juara}
                </span>
                <span class="text-xs font-semibold text-slate-400">{item.tahun}</span>
              </div>

              <div class="flex items-center gap-2 text-xs font-bold text-brand-700 mb-2">
                <i class={`fa-solid ${item.icon} text-emerald-600`}></i>
                <span>{item.kategori}</span>
              </div>

              <h3 class="font-heading font-extrabold text-base text-slate-900 leading-snug mb-3">
                {item.lomba}
              </h3>

              <div class="text-xs text-slate-500 bg-slate-50 p-3 rounded-xl border border-slate-100 mb-4">
                <div class="flex items-center gap-1.5 font-medium text-slate-700">
                  <i class="fa-solid fa-user-check text-brand-600"></i>
                  <span>Peraih: <strong>{item.peserta}</strong></span>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
              <span class="flex items-center gap-1">
                <i class="fa-solid fa-location-dot text-gold-500"></i> {item.tingkat}
              </span>
              <span class="font-bold text-emerald-600">Terverifikasi</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>
