---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/data';

const siteSettings = await getSiteSettings();
const ppdbUrl = siteSettings.ppdb_url || 'https://ppdb.smpislam-alkholili.sch.id';
const isExt = ppdbUrl.startsWith('http');

const tursoUrl = process.env.TURSO_DATABASE_URL || 'libsql://smp-memet.aws-ap-southeast-1.turso.io';
const tursoToken = process.env.TURSO_AUTH_TOKEN || 'eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTU0MDY0NzYsImlkIjoiMDFhMjA2NzktM2EwMS03ZTJhLWJhNzUtMjg1NTA1YTA1YmM5Iiwia2lkIjoiUUFlRERrU0pVQTJoZl9TTjRWaE9ZTUFrT1g2MUV3VWo0YS1qYllhZHYwcyIsInJpZCI6ImNlNWM2ODdjLTRhYzQtNDFkYS1hN2VkLWRiZDI0NTU2MjJiZSJ9.6u2b8t47piQWRWs-SvW1LgHUgqMd5V5ev1ZM2YHZCA9sSkjXs1VxeYt6n_fDuQpnchgJKhMqcciS26plEWFPCQ';
const tursoHttpHost = tursoUrl.replace(/^libsql:\/\//, 'https://');
---

<Layout 
  title="PPDB Online - Formulir Pendaftaran Siswa Baru SMP Islam Al-Kholili"
  description="Penerimaan Peserta Didik Baru (PPDB) SMP Islam Al-Kholili Kota Probolinggo. Pendaftaran online lengkap data calon siswa, data orang tua/wali, dan unggah berkas persyaratan."
  currentPage="ppdb"
>
  <!-- Page Header Banner -->
  <section class="bg-gradient-to-r from-brand-950 via-brand-900 to-emerald-900 text-white py-14 border-b border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-gold-400 uppercase tracking-widest mb-2">
          <i class="fa-solid fa-graduation-cap"></i> Penerimaan Siswa Baru
        </div>
        <h1 class="text-3xl sm:text-4xl font-heading font-extrabold tracking-tight">PPDB Online Tahun Ajaran 2026/2027</h1>
        <p class="text-emerald-200 text-sm mt-2 max-w-xl">
          Bergabunglah bersama keluarga besar SMP Islam Al-Kholili Kota Probolinggo. Sekolah Menengah Pertama Islam berkarakter Qur'ani, berakhlak mulia, dan berwawasan teknologi.
        </p>
      </div>
      <div class="flex items-center gap-2 text-xs text-slate-300 bg-white/10 px-4 py-2 rounded-lg backdrop-blur-sm">
        <a href="/" class="hover:text-white transition">Beranda</a>
        <span>/</span>
        <span class="text-gold-400 font-semibold">PPDB Online</span>
      </div>
    </div>
  </section>

  <!-- Main PPDB Content & Wizard Form -->
  <section class="py-14 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Top Highlight: Info Jalur & Tata Cara -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden group hover:border-brand-600 transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-brand-700 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-book-quran"></i>
          </div>
          <h3 class="font-heading font-bold text-lg text-slate-900">1. Jalur Tahfidz Qur'an</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Beasiswa bebas biaya pendidikan bagi calon siswa yang memiliki hafalan minimal 1-3 Juz Al-Qur'an dan lulus tes sima'an.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden group hover:border-brand-600 transition">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-gold-600 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-trophy"></i>
          </div>
          <h3 class="font-heading font-bold text-lg text-slate-900">2. Jalur Prestasi</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Apresiasi pembebasan biaya masuk bagi peraih ranking 1-3 di SD/MI atau juara perlombaan sains, seni, MTQ, dan olahraga.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden group hover:border-brand-600 transition">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-users"></i>
          </div>
          <h3 class="font-heading font-bold text-lg text-slate-900">3. Jalur Reguler</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Terbuka luas bagi seluruh lulusan SD/MI negeri & swasta yang berkomitmen menuntut ilmu dan berakhlak Qur'ani.
          </p>
        </div>
      </div>

      <!-- FORMULIR PENDAFTARAN RESMI PPDB -->
      <div id="registrationFormWrapper" class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
        
        <!-- Header Form -->
        <div class="bg-gradient-to-r from-brand-900 via-brand-800 to-emerald-900 p-6 sm:p-8 text-white relative">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <span class="px-3 py-1 rounded-full bg-gold-400 text-brand-950 font-bold text-xs uppercase tracking-wider">
                Formulir Pendaftaran Online
              </span>
              <h2 class="text-2xl sm:text-3xl font-heading font-extrabold mt-2">
                Penerimaan Peserta Didik Baru (PPDB) 2026/2027
              </h2>
              <p class="text-emerald-100 text-xs sm:text-sm mt-1">
                Silakan lengkapi formulir di bawah ini dengan data yang benar dan unggah dokumen berkas persyaratan.
              </p>
            </div>
            <div class="flex-shrink-0 text-right">
              <span class="text-xs text-emerald-200 block">Butuh Bantuan?</span>
              <a href={`https://wa.me/${siteSettings.whatsapp_number}?text=Assalamu'alaikum%20Panitia%20PPDB%20SMP%20Islam%20Al-Kholili`} target="_blank" class="inline-flex items-center gap-1.5 text-gold-300 font-bold text-xs hover:underline mt-1">
                <i class="fa-brands fa-whatsapp text-green-400"></i> WhatsApp Panitia
              </a>
            </div>
          </div>

          <!-- Wizard Step Navigation -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mt-8 pt-6 border-t border-brand-700/60 text-xs font-bold">
            <button type="button" onclick="goToStep(1)" id="stepTab1" class="step-tab-btn active px-3 py-2.5 rounded-xl bg-white/20 text-white flex items-center gap-2 border border-white/20 transition">
              <span class="w-6 h-6 rounded-full bg-gold-400 text-brand-950 flex items-center justify-center font-bold text-xs">1</span>
              <span>Data Calon Siswa</span>
            </button>
            <button type="button" onclick="goToStep(2)" id="stepTab2" class="step-tab-btn px-3 py-2.5 rounded-xl bg-white/5 text-slate-300 hover:text-white flex items-center gap-2 border border-white/10 transition">
              <span class="w-6 h-6 rounded-full bg-white/20 text-white flex items-center justify-center font-bold text-xs">2</span>
              <span>Data Orang Tua / Wali</span>
            </button>
            <button type="button" onclick="goToStep(3)" id="stepTab3" class="step-tab-btn px-3 py-2.5 rounded-xl bg-white/5 text-slate-300 hover:text-white flex items-center gap-2 border border-white/10 transition">
              <span class="w-6 h-6 rounded-full bg-white/20 text-white flex items-center justify-center font-bold text-xs">3</span>
              <span>Unggah Berkas</span>
            </button>
            <button type="button" onclick="goToStep(4)" id="stepTab4" class="step-tab-btn px-3 py-2.5 rounded-xl bg-white/5 text-slate-300 hover:text-white flex items-center gap-2 border border-white/10 transition">
              <span class="w-6 h-6 rounded-full bg-white/20 text-white flex items-center justify-center font-bold text-xs">4</span>
              <span>Konfirmasi & Kirim</span>
            </button>
          </div>
        </div>

        <!-- Form Body -->
        <form id="ppdbRegistrationForm" class="p-6 sm:p-10 space-y-8">
          
          <!-- STEP 1: DATA CALON SISWA BARU -->
          <div id="stepSection1" class="step-section space-y-6">
            <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
              <div>
                <h3 class="text-lg font-heading font-extrabold text-slate-900 flex items-center gap-2">
                  <i class="fa-solid fa-user-graduate text-brand-700"></i> Bagian 1: Data Calon Siswa Baru
                </h3>
                <p class="text-xs text-slate-500">Pastikan biodata sesuai dengan Akta Kelahiran dan Kartu Keluarga (KK).</p>
              </div>
              <span class="text-xs font-bold text-brand-700 bg-brand-50 px-3 py-1 rounded-full">Langkah 1 dari 4</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <!-- Nama Lengkap -->
              <div class="md:col-span-2">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputNamaLengkap">
                  Nama Lengkap Siswa <span class="text-red-500">*</span>
                </label>
                <input type="text" id="inputNamaLengkap" name="nama_lengkap" required placeholder="Contoh: Muhammad Farhan Al-Fatih" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm font-medium" />
              </div>

              <!-- Jenis Kelamin -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputJenisKelamin">
                  Jenis Kelamin <span class="text-red-500">*</span>
                </label>
                <select id="inputJenisKelamin" name="jenis_kelamin" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white">
                  <option value="">-- Pilih Jenis Kelamin --</option>
                  <option value="Laki-laki">Laki-laki (Santri Putra)</option>
                  <option value="Perempuan">Perempuan (Santri Putri)</option>
                </select>
              </div>

              <!-- NISN -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputNisn">
                  NISN (Nomor Induk Siswa Nasional) <span class="text-red-500">*</span>
                </label>
                <input type="text" id="inputNisn" name="nisn" required maxlength="10" placeholder="10 digit nomor NISN dari SD/MI" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm" />
              </div>

              <!-- Tempat Lahir -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputTempatLahir">
                  Tempat Lahir <span class="text-red-500">*</span>
                </label>
                <input type="text" id="inputTempatLahir" name="tempat_lahir" required placeholder="Kota / Kabupaten Lahir" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm" />
              </div>

              <!-- Tanggal Lahir -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputTanggalLahir">
                  Tanggal Lahir <span class="text-red-500">*</span>
                </label>
                <input type="date" id="inputTanggalLahir" name="tanggal_lahir" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
              </div>

              <!-- Alamat Lengkap -->
              <div class="md:col-span-2">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputAlamatLengkap">
                  Alamat Lengkap Domisili Siswa <span class="text-red-500">*</span>
                </label>
                <textarea id="inputAlamatLengkap" name="alamat_lengkap" rows="2" required placeholder="Nama Jalan, No. Rumah, RT/RW, Kelurahan, Kecamatan, Kota Probolinggo" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm"></textarea>
              </div>

              <!-- Email Siswa/Ortu -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputEmail">
                  Email Siswa / Orang Tua <span class="text-slate-400 font-normal lowercase">(jika ada)</span>
                </label>
                <input type="email" id="inputEmail" name="email" placeholder="contoh: wali.murid@gmail.com" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm" />
              </div>

              <!-- Nomor WhatsApp -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputNoWa">
                  Nomor WhatsApp Aktif Siswa / Wali <span class="text-red-500">*</span>
                </label>
                <input type="tel" id="inputNoWa" name="no_wa" required placeholder="Contoh: 085234567890" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm" />
              </div>

              <!-- Nama Sekolah Asal -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputAsalSekolah">
                  Nama Sekolah Asal (SD / MI) <span class="text-red-500">*</span>
                </label>
                <input type="text" id="inputAsalSekolah" name="asal_sekolah" required placeholder="Contoh: SD Islam / SDN Kedopok 1" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm" />
              </div>

              <!-- Alamat Sekolah Asal -->
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputAlamatSekolahAsal">
                  Alamat Sekolah Asal <span class="text-red-500">*</span>
                </label>
                <input type="text" id="inputAlamatSekolahAsal" name="alamat_sekolah_asal" required placeholder="Jalan / Kelurahan / Kota Sekolah Asal" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm" />
              </div>

              <!-- Jalur Pendaftaran -->
              <div class="md:col-span-2">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputJalur">
                  Pilihan Jalur Pendaftaran <span class="text-red-500">*</span>
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <label class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200 cursor-pointer hover:border-brand-600 hover:bg-brand-50/50 transition">
                    <input type="radio" name="jalur" value="Reguler" checked class="text-brand-700 focus:ring-brand-600" />
                    <div>
                      <strong class="text-xs text-slate-900 block font-heading">Jalur Reguler</strong>
                      <span class="text-[11px] text-slate-500">Lulusan SD/MI umum</span>
                    </div>
                  </label>
                  <label class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200 cursor-pointer hover:border-brand-600 hover:bg-brand-50/50 transition">
                    <input type="radio" name="jalur" value="Tahfidz" class="text-brand-700 focus:ring-brand-600" />
                    <div>
                      <strong class="text-xs text-slate-900 block font-heading">Jalur Tahfidz</strong>
                      <span class="text-[11px] text-slate-500">Hafalan min. 1 Juz</span>
                    </div>
                  </label>
                  <label class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200 cursor-pointer hover:border-brand-600 hover:bg-brand-50/50 transition">
                    <input type="radio" name="jalur" value="Prestasi" class="text-brand-700 focus:ring-brand-600" />
                    <div>
                      <strong class="text-xs text-slate-900 block font-heading">Jalur Prestasi</strong>
                      <span class="text-[11px] text-slate-500">Akademik & Kejuaraan</span>
                    </div>
                  </label>
                </div>
              </div>

            </div>

            <div class="pt-4 flex justify-end">
              <button type="button" onclick="nextStep(1)" class="px-6 py-3 rounded-xl bg-brand-700 hover:bg-brand-800 text-white font-bold text-sm shadow-md flex items-center gap-2 transition">
                <span>Lanjut ke Data Orang Tua</span>
                <i class="fa-solid fa-arrow-right"></i>
              </button>
            </div>
          </div>

          <!-- STEP 2: DATA ORANG TUA / WALI -->
          <div id="stepSection2" class="step-section hidden space-y-6">
            <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
              <div>
                <h3 class="text-lg font-heading font-extrabold text-slate-900 flex items-center gap-2">
                  <i class="fa-solid fa-users text-gold-500"></i> Bagian 2: Data Orang Tua / Wali
                </h3>
                <p class="text-xs text-slate-500">Data ayah kandung dan ibu kandung calon peserta didik baru.</p>
              </div>
              <span class="text-xs font-bold text-brand-700 bg-brand-50 px-3 py-1 rounded-full">Langkah 2 dari 4</span>
            </div>

            <!-- 2.A. AYAH KANDUNG -->
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
              <h4 class="text-sm font-heading font-extrabold text-slate-900 flex items-center gap-2 pb-2 border-b border-slate-200">
                <i class="fa-solid fa-user-tie text-brand-700"></i> A. Data Ayah Kandung
              </h4>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputNamaAyah">
                    Nama Lengkap Ayah Kandung <span class="text-red-500">*</span>
                  </label>
                  <input type="text" id="inputNamaAyah" name="nama_ayah" required placeholder="Nama lengkap beserta gelar (jika ada)" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputTempatLahirAyah">
                    Tempat Lahir Ayah
                  </label>
                  <input type="text" id="inputTempatLahirAyah" name="tempat_lahir_ayah" placeholder="Kota/Kabupaten Lahir Ayah" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputTanggalLahirAyah">
                    Tanggal Lahir Ayah
                  </label>
                  <input type="date" id="inputTanggalLahirAyah" name="tanggal_lahir_ayah" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputPekerjaanAyah">
                    Pekerjaan Ayah <span class="text-red-500">*</span>
                  </label>
                  <input type="text" id="inputPekerjaanAyah" name="pekerjaan_ayah" required placeholder="Contoh: Wiraswasta, PNS, Petani, Pegawai Swasta" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputPendidikanAyah">
                    Pendidikan Terakhir Ayah
                  </label>
                  <select id="inputPendidikanAyah" name="pendidikan_ayah" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white">
                    <option value="">-- Pilih Pendidikan Terakhir --</option>
                    <option value="SD / Sederajat">SD / Sederajat</option>
                    <option value="SMP / Sederajat">SMP / Sederajat</option>
                    <option value="SMA / SMK / MA">SMA / SMK / MA</option>
                    <option value="D3 / Diploma">D3 / Diploma</option>
                    <option value="S1 / Sarjana">S1 / Sarjana</option>
                    <option value="S2 / Magister">S2 / Magister</option>
                    <option value="S3 / Doktor">S3 / Doktor</option>
                    <option value="Lainnya">Lainnya</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputTeleponAyah">
                    Nomor Telepon / HP / WA Ayah <span class="text-red-500">*</span>
                  </label>
                  <input type="tel" id="inputTeleponAyah" name="telepon_ayah" required placeholder="Contoh: 081234567890" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
                </div>
              </div>
            </div>

            <!-- 2.B. IBU KANDUNG -->
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
              <h4 class="text-sm font-heading font-extrabold text-slate-900 flex items-center gap-2 pb-2 border-b border-slate-200">
                <i class="fa-solid fa-person-dress text-brand-700"></i> B. Data Ibu Kandung
              </h4>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputNamaIbu">
                    Nama Lengkap Ibu Kandung <span class="text-red-500">*</span>
                  </label>
                  <input type="text" id="inputNamaIbu" name="nama_ibu" required placeholder="Nama lengkap ibu kandung" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputTempatLahirIbu">
                    Tempat Lahir Ibu
                  </label>
                  <input type="text" id="inputTempatLahirIbu" name="tempat_lahir_ibu" placeholder="Kota/Kabupaten Lahir Ibu" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="inputTanggalLahirIbu">
                    Tanggal Lahir Ibu
                  </label>
                  <input type="date" id="inputTanggalLahirIbu" name="tanggal_lahir_ibu" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-600 focus:outline-none text-sm bg-white" />
                </div>

                <div>
