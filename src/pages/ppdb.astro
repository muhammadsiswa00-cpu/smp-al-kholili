  <script is:inline define:vars={{ tursoEndpoint: `${tursoHttpHost}/v2/pipeline`, tursoBearer: tursoToken, adminWa: siteSettings.whatsapp_number }}>
    let currentStep = 1;
    let uploadedFiles = {
      berkas_akta: '',
      berkas_ktp: '',
      berkas_foto: '',
      berkas_rapor: '',
      berkas_skl: ''
    };

    window.goToStep = function(step) {
      if (step < 1 || step > 4) return;
      currentStep = step;

      // Update tabs UI
      document.querySelectorAll('.step-tab-btn').forEach((btn, idx) => {
        if (idx + 1 === step) {
          btn.className = "step-tab-btn active px-3 py-2.5 rounded-xl bg-white/20 text-white flex items-center gap-2 border border-white/20 transition";
          btn.querySelector('span:first-child').className = "w-6 h-6 rounded-full bg-gold-400 text-brand-950 flex items-center justify-center font-bold text-xs";
        } else {
          btn.className = "step-tab-btn px-3 py-2.5 rounded-xl bg-white/5 text-slate-300 hover:text-white flex items-center gap-2 border border-white/10 transition";
          btn.querySelector('span:first-child').className = "w-6 h-6 rounded-full bg-white/20 text-white flex items-center justify-center font-bold text-xs";
        }
      });

      // Update sections
      document.querySelectorAll('.step-section').forEach(sec => sec.classList.add('hidden'));
      const activeSection = document.getElementById(`stepSection${step}`);
      if (activeSection) activeSection.classList.remove('hidden');

      // If step 4, populate summary
      if (step === 4) {
        populateSummary();
      }

      window.scrollTo({
        top: document.getElementById('registrationFormWrapper').offsetTop - 80,
        behavior: 'smooth'
      });
    };

    window.nextStep = function(fromStep) {
      // Basic validations
      if (fromStep === 1) {
        const nama = document.getElementById('inputNamaLengkap').value.trim();
        const jk = document.getElementById('inputJenisKelamin').value;
        const nisn = document.getElementById('inputNisn').value.trim();
        const noWa = document.getElementById('inputNoWa').value.trim();
        const sekolah = document.getElementById('inputAsalSekolah').value.trim();

        if (!nama || !jk || !nisn || !noWa || !sekolah) {
          alert("Mohon lengkapi data wajib pada Bagian 1 (Nama, Jenis Kelamin, NISN, No. WhatsApp, dan Asal Sekolah).");
          return;
        }
      } else if (fromStep === 2) {
        const namaAyah = document.getElementById('inputNamaAyah').value.trim();
        const namaIbu = document.getElementById('inputNamaIbu').value.trim();
        if (!namaAyah || !namaIbu) {
          alert("Mohon lengkapi Nama Ayah Kandung dan Nama Ibu Kandung pada Bagian 2.");
          return;
        }
      }
      window.goToStep(fromStep + 1);
    };

    // Compress & Read image as Data URL
    window.handleFileUpload = function(inputId, previewId, iconId, badgeId, hiddenInputId) {
      const fileInput = document.getElementById(inputId);
      const previewImg = document.getElementById(previewId);
      const icon = document.getElementById(iconId);
      const badge = document.getElementById(badgeId);
      const hiddenInput = document.getElementById(hiddenInputId);

      if (!fileInput || !fileInput.files || fileInput.files.length === 0) return;
      const file = fileInput.files[0];

      // Read file
      const reader = new FileReader();
      reader.onload = function(e) {
        const rawDataUrl = e.target.result;

        // If image, compress via canvas
        if (file.type.startsWith('image/')) {
          const img = new Image();
          img.onload = function() {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const maxDim = 900;
            let width = img.width;
            let height = img.height;

            if (width > maxDim || height > maxDim) {
              if (width > height) {
                height = Math.round((height * maxDim) / width);
                width = maxDim;
              } else {
                width = Math.round((width * maxDim) / height);
                height = maxDim;
              }
            }

            canvas.width = width;
            canvas.height = height;
            ctx.drawImage(img, 0, 0, width, height);
            const compressedUrl = canvas.toDataURL('image/jpeg', 0.75);

            if (previewImg) {
              previewImg.src = compressedUrl;
              previewImg.classList.remove('hidden');
            }
            if (icon) icon.classList.add('hidden');
            if (badge) {
              badge.textContent = "Sudah Terunggah";
              badge.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800";
            }
            if (hiddenInput) hiddenInput.value = compressedUrl;
          };
          img.src = rawDataUrl;
        } else {
          // PDF or non-image
          if (badge) {
            badge.textContent = file.name;
            badge.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800";
          }
          if (hiddenInput) hiddenInput.value = rawDataUrl;
        }
      };
      reader.readAsDataURL(file);
    };

    function populateSummary() {
      document.getElementById('summaryNama').textContent = document.getElementById('inputNamaLengkap').value.trim() || '-';
      document.getElementById('summaryNisnJk').textContent = `${document.getElementById('inputNisn').value.trim() || '-'} / ${document.getElementById('inputJenisKelamin').value || '-'}`;
      document.getElementById('summaryTtl').textContent = `${document.getElementById('inputTempatLahir').value.trim() || '-'}, ${document.getElementById('inputTanggalLahir').value || '-'}`;
      document.getElementById('summarySekolah').textContent = `${document.getElementById('inputAsalSekolah').value.trim() || '-'} (${document.getElementById('inputAlamatSekolahAsal').value.trim() || '-'})`;
      document.getElementById('summaryOrtu').textContent = `${document.getElementById('inputNamaAyah').value.trim() || '-'} / ${document.getElementById('inputNamaIbu').value.trim() || '-'}`;
      document.getElementById('summaryWa').textContent = document.getElementById('inputNoWa').value.trim() || '-';

      const berkasKeys = [
        { label: 'Akta Kelahiran', val: document.getElementById('hiddenAktaVal').value },
        { label: 'KTP Ortu', val: document.getElementById('hiddenKtpVal').value },
        { label: 'Pas Foto 3x4', val: document.getElementById('hiddenFotoVal').value },
        { label: 'Rapor', val: document.getElementById('hiddenRaporVal').value },
        { label: 'SKL/Ijazah', val: document.getElementById('hiddenSklVal').value }
      ];

      const listContainer = document.getElementById('summaryBerkasList');
      listContainer.innerHTML = berkasKeys.map(b => `
        <div class="p-2 rounded-lg border ${b.val ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-slate-100 border-slate-200 text-slate-400'}">
          <i class="fa-solid ${b.val ? 'fa-circle-check text-emerald-600' : 'fa-circle-xmark'} mb-1 block"></i>
          <span>${b.label}</span>
        </div>
      `).join('');
    }

    // Submit PPDB Form
    document.getElementById('ppdbRegistrationForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('submitPpdbBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Menyimpan Data Pendaftaran...</span>`;

      try {
        const randNum = Math.floor(1000 + Math.random() * 9000);
        const regId = `AK-26-${randNum}`;
        const now = new Date();
        const waktuFormatted = now.toISOString().replace('T', ' ').substring(0, 19);

        const jalurEl = document.querySelector('input[name="jalur"]:checked');
        const jalur = jalurEl ? jalurEl.value : 'Reguler';

        const payload = {
          id: regId,
          no_pendaftaran: regId,
          nama: document.getElementById('inputNamaLengkap').value.trim(),
          nama_lengkap: document.getElementById('inputNamaLengkap').value.trim(),
          jenis_kelamin: document.getElementById('inputJenisKelamin').value,
          nisn: document.getElementById('inputNisn').value.trim(),
          tempat_lahir: document.getElementById('inputTempatLahir').value.trim(),
          tanggal_lahir: document.getElementById('inputTanggalLahir').value,
          alamat_lengkap: document.getElementById('inputAlamatLengkap').value.trim(),
          email: document.getElementById('inputEmail').value.trim(),
          no_wa: document.getElementById('inputNoWa').value.trim(),
          no_whatsapp: document.getElementById('inputNoWa').value.trim(),
          asal_sekolah: document.getElementById('inputAsalSekolah').value.trim(),
          alamat_sekolah_asal: document.getElementById('inputAlamatSekolahAsal').value.trim(),
          jalur: jalur,
          nama_ayah: document.getElementById('inputNamaAyah').value.trim(),
          tempat_lahir_ayah: document.getElementById('inputTempatLahirAyah').value.trim(),
          tanggal_lahir_ayah: document.getElementById('inputTanggalLahirAyah').value,
          pekerjaan_ayah: document.getElementById('inputPekerjaanAyah').value.trim(),
          pendidikan_ayah: document.getElementById('inputPendidikanAyah').value,
          telepon_ayah: document.getElementById('inputTeleponAyah').value.trim(),
          nama_ibu: document.getElementById('inputNamaIbu').value.trim(),
          tempat_lahir_ibu: document.getElementById('inputTempatLahirIbu').value.trim(),
          tanggal_lahir_ibu: document.getElementById('inputTanggalLahirIbu').value,
          pekerjaan_ibu: document.getElementById('inputPekerjaanIbu').value.trim(),
          pendidikan_ibu: document.getElementById('inputPendidikanIbu').value,
          telepon_ibu: document.getElementById('inputTeleponIbu').value.trim(),
          berkas_akta: document.getElementById('hiddenAktaVal').value || '',
          berkas_ktp: document.getElementById('hiddenKtpVal').value || '',
          berkas_foto: document.getElementById('hiddenFotoVal').value || '',
          berkas_rapor: document.getElementById('hiddenRaporVal').value || '',
          berkas_skl: document.getElementById('hiddenSklVal').value || '',
          status: 'Menunggu',
          waktu: waktuFormatted,
          created_at: waktuFormatted
        };

        // 1. Simpan ke LocalStorage agar langsung terbaca di Admin
        try {
          const savedLocal = JSON.parse(localStorage.getItem('alkholili_ppdb_submissions') || '[]');
          savedLocal.unshift(payload);
          localStorage.setItem('alkholili_ppdb_submissions', JSON.stringify(savedLocal));
        } catch (lsErr) {
          console.warn("LocalStorage save warning:", lsErr);
        }

        // 2. Simpan ke Turso DB jika ada jaringan
        try {
          const sqlStmt = `INSERT OR REPLACE INTO ppdb (id, no_pendaftaran, nama_lengkap, jenis_kelamin, nisn, tempat_lahir, tanggal_lahir, alamat_lengkap, email, asal_sekolah, alamat_sekolah_asal, jalur, no_whatsapp, nama_ayah, tempat_lahir_ayah, tanggal_lahir_ayah, pekerjaan_ayah, pendidikan_ayah, telepon_ayah, nama_ibu, tempat_lahir_ibu, tanggal_lahir_ibu, pekerjaan_ibu, pendidikan_ibu, telepon_ibu, berkas_akta, berkas_ktp, berkas_foto, berkas_rapor, berkas_skl, status, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`;
          
          const args = [
            { type: "text", value: payload.id },
            { type: "text", value: payload.id },
            { type: "text", value: payload.nama_lengkap },
            { type: "text", value: payload.jenis_kelamin },
            { type: "text", value: payload.nisn },
            { type: "text", value: payload.tempat_lahir },
            { type: "text", value: payload.tanggal_lahir },
            { type: "text", value: payload.alamat_lengkap },
            { type: "text", value: payload.email },
            { type: "text", value: payload.asal_sekolah },
            { type: "text", value: payload.alamat_sekolah_asal },
            { type: "text", value: payload.jalur },
            { type: "text", value: payload.no_wa },
            { type: "text", value: payload.nama_ayah },
            { type: "text", value: payload.tempat_lahir_ayah },
            { type: "text", value: payload.tanggal_lahir_ayah },
            { type: "text", value: payload.pekerjaan_ayah },
            { type: "text", value: payload.pendidikan_ayah },
            { type: "text", value: payload.telepon_ayah },
            { type: "text", value: payload.nama_ibu },
            { type: "text", value: payload.tempat_lahir_ibu },
            { type: "text", value: payload.tanggal_lahir_ibu },
            { type: "text", value: payload.pekerjaan_ibu },
            { type: "text", value: payload.pendidikan_ibu },
            { type: "text", value: payload.telepon_ibu },
            { type: "text", value: payload.berkas_akta },
            { type: "text", value: payload.berkas_ktp },
            { type: "text", value: payload.berkas_foto },
            { type: "text", value: payload.berkas_rapor },
            { type: "text", value: payload.berkas_skl },
            { type: "text", value: payload.status },
            { type: "text", value: payload.created_at }
          ];

          await fetch(tursoEndpoint, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${tursoBearer}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              requests: [
                { type: "execute", stmt: { sql: sqlStmt, args } },
                { type: "close" }
              ]
            })
          });
        } catch (tursoErr) {
          console.warn("Turso sync fallback to local:", tursoErr);
        }

        // 3. Tampilkan Lembar Bukti Pendaftaran
        document.getElementById('ppdbRegistrationForm').classList.add('hidden');
        const modal = document.getElementById('ppdbSuccessModal');
        modal.classList.remove('hidden');

        document.getElementById('buktiNoReg').textContent = payload.id;
        document.getElementById('buktiJalur').textContent = `Jalur ${payload.jalur}`;
        document.getElementById('buktiNama').textContent = payload.nama_lengkap;
        document.getElementById('buktiNisn').textContent = payload.nisn;
        document.getElementById('buktiJk').textContent = payload.jenis_kelamin;
        document.getElementById('buktiTtl').textContent = `${payload.tempat_lahir}, ${payload.tanggal_lahir}`;
        document.getElementById('buktiAsalSekolah').textContent = payload.asal_sekolah;
        document.getElementById('buktiOrtu').textContent = `${payload.nama_ayah} / ${payload.nama_ibu}`;
        document.getElementById('buktiWa').textContent = payload.no_wa;
        document.getElementById('buktiWaktu').textContent = payload.waktu;

        // WhatsApp Confirmation Link
        const waMsg = encodeURIComponent(`Assalamu'alaikum Panitia PPDB SMP Islam Al-Kholili,\nSaya telah mendaftarkan calon siswa baru secara online:\n- No. Registrasi: ${payload.id}\n- Nama Siswa: ${payload.nama_lengkap}\n- Jalur: ${payload.jalur}\n- Asal Sekolah: ${payload.asal_sekolah}\nMohon konfirmasi dan verifikasi pendaftaran kami. Terima kasih.`);
        document.getElementById('btnWaKonfirmasi').href = `https://wa.me/${adminWa}?text=${waMsg}`;

        window.scrollTo({
          top: modal.offsetTop - 60,
          behavior: 'smooth'
        });

      } catch (err) {
        alert("Terjadi kesalahan saat memproses pendaftaran. Silakan coba lagi.");
        console.error(err);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> <span>Kirim Formulir Pendaftaran PPDB</span>`;
      }
    });

    window.resetFormAndRegisterAgain = function() {
      document.getElementById('ppdbRegistrationForm').reset();
      document.getElementById('ppdbRegistrationForm').classList.remove('hidden');
      document.getElementById('ppdbSuccessModal').classList.add('hidden');
      window.goToStep(1);
    };
  </script>
</Layout>
