    window.loadTeacherAttendanceForDate = function() {
      const dateInput = document.getElementById('absenGuruTanggal');
      const date = dateInput ? dateInput.value : new Date().toISOString().substring(0, 10);
      const container = document.getElementById('teacherAttendanceTableBody');
      if (!container) return;

      const existing = currentTeacherAttendance.find(a => a.tanggal === date);
      const existingRecords = existing?.records || [];

      if (currentTeachers.length === 0) {
        container.innerHTML = `<tr><td colspan="9" class="px-4 py-8 text-center text-slate-400">Belum ada data guru. Silakan tambahkan guru di tab Data Guru.</td></tr>`;
        return;
      }

      let hCount = 0, sCount = 0, iCount = 0, dCount = 0;

      container.innerHTML = currentTeachers.map((g, idx) => {
        const rec = existingRecords.find(r => String(r.guru_id) === String(g.id));
        const curStatus = rec ? rec.status : 'Belum Absen';
        const curMasuk = rec ? (rec.jam_masuk || '-') : '-';
        const curPulang = rec ? (rec.jam_pulang || '-') : '-';
        const curKet = rec ? (rec.keterangan || '-') : '-';
        const curMetode = rec ? (rec.metode || (rec.foto_selfie ? 'Wajah & GPS' : 'Manual')) : '-';

        if (curStatus === 'Hadir' || curStatus === 'Terlambat') hCount++;
        else if (curStatus === 'Sakit') sCount++;
        else if (curStatus === 'Izin') iCount++;
        else if (curStatus === 'Dinas Luar') dCount++;

        let statusBadge = `<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500">Belum Presensi</span>`;
        if (curStatus === 'Hadir') {
          statusBadge = `<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 flex items-center gap-1 w-max"><i class="fa-solid fa-circle-check text-[9px]"></i> Hadir</span>`;
        } else if (curStatus === 'Terlambat') {
          statusBadge = `<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 flex items-center gap-1 w-max"><i class="fa-solid fa-clock text-[9px]"></i> Terlambat</span>`;
        } else if (curStatus === 'Sakit') {
          statusBadge = `<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 flex items-center gap-1 w-max"><i class="fa-solid fa-hospital-user text-[9px]"></i> Sakit</span>`;
        } else if (curStatus === 'Izin') {
          statusBadge = `<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800 flex items-center gap-1 w-max"><i class="fa-solid fa-envelope-open-text text-[9px]"></i> Izin</span>`;
        } else if (curStatus === 'Dinas Luar') {
          statusBadge = `<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800 flex items-center gap-1 w-max"><i class="fa-solid fa-briefcase text-[9px]"></i> Dinas Luar</span>`;
        }

        const photoHtml = rec?.foto_selfie 
          ? `<button type="button" onclick="showGuruPhotoModal('${rec.foto_selfie}', '${g.nama}', '${curMasuk}', '${curMetode}', '${rec.jarak_meter || 0}m')" class="relative group block w-10 h-10 rounded-xl overflow-hidden border border-brand-300 shadow hover:scale-105 transition" title="Lihat Foto Wajah"><img src="${rec.foto_selfie}" class="w-full h-full object-cover" /><div class="absolute inset-0 bg-brand-900/40 opacity-0 group-hover:opacity-100 flex items-center justify-center text-white text-[10px]"><i class="fa-solid fa-magnifying-glass"></i></div></button>`
          : `<div class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 text-slate-400 flex items-center justify-center text-xs"><i class="fa-solid fa-user"></i></div>`;

        let lokasiBadge = `<span class="text-slate-400 text-[10px]">-</span>`;
        if (rec?.jarak_meter !== undefined && rec?.jarak_meter !== null) {
          lokasiBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 text-[10px] font-bold border border-emerald-200"><i class="fa-solid fa-location-dot text-emerald-600"></i> ${rec.jarak_meter}m (Valid)</span>`;
        } else if (rec) {
          lokasiBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[10px] font-bold"><i class="fa-solid fa-pen-nib text-[9px]"></i> ${curMetode}</span>`;
        }

        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="px-4 py-3 text-center font-bold text-slate-400">${idx + 1}</td>
            <td class="px-4 py-3">${photoHtml}</td>
            <td class="px-4 py-3">
              <strong class="text-slate-900 block font-semibold">${g.nama}</strong>
              <span class="text-[10px] text-slate-500 font-mono">NIP: ${g.nip || '-'} • ${g.jabatan || 'Guru'}</span>
            </td>
            <td class="px-4 py-3">${statusBadge}</td>
            <td class="px-4 py-3 font-mono font-semibold text-slate-800">${curMasuk}</td>
            <td class="px-4 py-3 font-mono font-semibold text-slate-800">${curPulang}</td>
            <td class="px-4 py-3">${lokasiBadge}</td>
            <td class="px-4 py-3 text-slate-600 text-[11px] max-w-xs truncate" title="${curKet}">${curKet}</td>
            <td class="px-4 py-3 text-center whitespace-nowrap space-x-1">
              <button type="button" onclick="openAdminManualModal('${g.id}')" class="p-1.5 text-brand-700 hover:bg-brand-50 rounded-lg transition" title="Edit Presensi Manual">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              ${rec ? `
              <button type="button" onclick="deleteTeacherAttendanceRecord('${g.id}')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition" title="Hapus Presensi Hari Ini">
                <i class="fa-solid fa-trash-can"></i>
              </button>` : ''}
            </td>
          </tr>
        `;
      }).join('');

      document.getElementById('statGuruHadir').textContent = hCount;
      document.getElementById('statGuruSakit').textContent = sCount;
      document.getElementById('statGuruIzin').textContent = iCount;
      document.getElementById('statGuruDinas').textContent = dCount;
      document.getElementById('statGuruTotal').textContent = currentTeachers.length;
    };

