    document.getElementById('studentDataForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const editId = document.getElementById('editStudentId').value;
      const isEdit = Boolean(editId);

      const studentObj = {
        id: isEdit ? Number(editId) : Date.now(),
        nis: document.getElementById('modalStudentNis').value.trim(),
        nisn: document.getElementById('modalStudentNisn').value.trim(),
        nama: document.getElementById('modalStudentNama').value.trim(),
        jenis_kelamin: document.getElementById('modalStudentJk').value,
        kelas: document.getElementById('modalStudentKelas').value,
        tempat_lahir: document.getElementById('modalStudentTempatLahir').value.trim(),
        tanggal_lahir: document.getElementById('modalStudentTanggalLahir').value,
        alamat: document.getElementById('modalStudentAlamat').value.trim(),
        nama_ortu: document.getElementById('modalStudentOrtu').value.trim(),
        telepon_ortu: document.getElementById('modalStudentTelepon').value.trim(),
        status: document.getElementById('modalStudentStatus').value
      };

      if (isEdit) {
        currentStudents = currentStudents.map(s => s.id === Number(editId) ? studentObj : s);
      } else {
        currentStudents.unshift(studentObj);
      }

      try {
        localStorage.setItem('alkholili_students_data', JSON.stringify(currentStudents));
      } catch (e) {}

      // Save to Turso
      await executeTursoSql(
        `INSERT OR REPLACE INTO siswa (id, nis, nisn, nama, jenis_kelamin, kelas, tempat_lahir, tanggal_lahir, alamat, nama_ortu, telepon_ortu, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          { type: "integer", value: studentObj.id },
          { type: "text", value: studentObj.nis },
          { type: "text", value: studentObj.nisn },
          { type: "text", value: studentObj.nama },
          { type: "text", value: studentObj.jenis_kelamin },
          { type: "text", value: studentObj.kelas },
          { type: "text", value: studentObj.tempat_lahir },
          { type: "text", value: studentObj.tanggal_lahir },
          { type: "text", value: studentObj.alamat },
          { type: "text", value: studentObj.nama_ortu },
          { type: "text", value: studentObj.telepon_ortu },
          { type: "text", value: studentObj.status }
        ]
      );

      showToast(`Data siswa '${studentObj.nama}' berhasil disimpan!`);
      closeStudentModal();
      renderStudents();
