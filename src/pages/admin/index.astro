    // 10.6 TABEL RIWAYAT PRESENSI GURU PRIBADI
    function renderSelfAttendanceHistory(teacherId) {
      const tbody = document.getElementById('selfAttendanceHistoryTableBody');
      if (!tbody) return;

      const history = [];
      currentTeacherAttendance.forEach(att => {
        const rec = att.records?.find(r => String(r.guru_id) === String(teacherId));
        if (rec) {
          history.push({
            tanggal: att.tanggal,
            ...rec
          });
        }
      });

      if (history.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="px-4 py-8 text-center text-slate-400">Belum ada riwayat presensi tercatat.</td></tr>`;
        return;
      }

      // Sort newest first
      history.sort((a, b) => new Date(b.tanggal).getTime() - new Date(a.tanggal).getTime());

      tbody.innerHTML = history.slice(0, 30).map(h => {
        let badgeColor = "bg-emerald-100 text-emerald-800";
        if (h.status === 'Terlambat') badgeColor = "bg-amber-100 text-amber-800";
        else if (h.status === 'Sakit') badgeColor = "bg-rose-100 text-rose-800";
        else if (h.status === 'Izin') badgeColor = "bg-blue-100 text-blue-800";
        else if (h.status === 'Dinas Luar') badgeColor = "bg-purple-100 text-purple-800";

        const photoHtml = h.foto_selfie 
          ? `<button type="button" onclick="showGuruPhotoModal('${h.foto_selfie}', '${h.nama}', '${h.jam_masuk || '-'}', '${h.metode || 'Wajah & GPS'}', '${h.jarak_meter || 0}m')" class="w-9 h-9 rounded-xl overflow-hidden border border-brand-300 shadow hover:scale-105 transition block"><img src="${h.foto_selfie}" class="w-full h-full object-cover" /></button>`
          : `<span class="w-9 h-9 rounded-xl bg-slate-100 border border-slate-200 text-slate-400 flex items-center justify-center text-xs"><i class="fa-solid fa-user"></i></span>`;

        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="px-4 py-3 font-semibold text-slate-800 whitespace-nowrap">${h.tanggal}</td>
            <td class="px-4 py-3">${photoHtml}</td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ${badgeColor}">
                ${h.status}
              </span>
            </td>
            <td class="px-4 py-3 font-mono font-semibold text-slate-700">${h.jam_masuk || '-'}</td>
            <td class="px-4 py-3 font-mono font-semibold text-slate-700">${h.jam_pulang || '-'}</td>
            <td class="px-4 py-3">
              <span class="text-[11px] font-medium text-slate-600">${h.metode || 'Wajah & GPS'}</span>
            </td>
            <td class="px-4 py-3 text-slate-500">${h.keterangan || '-'}</td>
          </tr>
        `;
      }).join('');
    }

