      existing.izin = i;
      existing.dinas_luar = d;

      try {
        localStorage.setItem('alkholili_attendance_teachers', JSON.stringify(currentTeacherAttendance));
      } catch (err) {}

      await executeTursoSql(
        `INSERT OR REPLACE INTO absen_guru (id, tanggal, total_guru, hadir, sakit, izin, dinas_luar, records, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          { type: "text", value: existing.id },
          { type: "text", value: existing.tanggal },
          { type: "integer", value: existing.total_guru },
          { type: "integer", value: existing.hadir },
          { type: "integer", value: existing.sakit },
          { type: "integer", value: existing.izin },
          { type: "integer", value: existing.dinas_luar },
          { type: "text", value: JSON.stringify(existing.records) },
          { type: "text", value: existing.created_at }
        ]
      );

      showToast("Data presensi guru berhasil dihapus.");
      loadTeacherAttendanceForDate();
    };

    // 10.9 MODAL PREVIEW FOTO SELFIE
    window.showGuruPhotoModal = function(imgSrc, nama, jam, metode, gpsInfo) {
      document.getElementById('modalFotoGuruImg').src = imgSrc;
      document.getElementById('modalFotoGuruNama').textContent = `Foto Verifikasi: ${nama}`;
      document.getElementById('modalFotoGuruJam').textContent = `${jam} WIB`;
      document.getElementById('modalFotoGuruMetode').textContent = metode || 'Verifikasi Wajah & GPS';
      document.getElementById('modalFotoGuruGps').textContent = gpsInfo || 'Lokasi Valid di Sekolah';
      document.getElementById('modalFotoWajahGuru')?.classList.remove('hidden');
    };

    window.closeGuruPhotoModal = function() {
      document.getElementById('modalFotoWajahGuru')?.classList.add('hidden');
    };

    // ========================================================
    // 11. MANAGE DEWAN GURU & FOTO
    // ========================================================
    window.toggleGuruPassVisibility = function() {
      const inp = document.getElementById('guruPassword');
      const icon = document.getElementById('guruPassEyeIcon');
      if (!inp) return;
      if (inp.type === 'password') {
        inp.type = 'text';
        if (icon) {
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        }
      } else {
        inp.type = 'password';
        if (icon) {
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      }
    };

    function renderTeachers() {
      const container = document.getElementById('teachersTableBody');
      if (!container) return;
      container.innerHTML = currentTeachers.map(t => `
        <tr class="hover:bg-slate-50 transition">
          <td class="px-4 py-3">
            <div class="w-10 h-10 rounded-xl overflow-hidden bg-white shadow border border-slate-200">
              <img src="${t.foto || '/assets/img/teachers/male-1.svg'}" class="w-full h-full object-cover" />
            </div>
          </td>
          <td class="px-4 py-3 font-semibold text-slate-800">${t.nama}</td>
          <td class="px-4 py-3 font-mono text-[11px] text-slate-600 font-semibold">${t.nip || '<span class="text-slate-400 italic">Belum diisi</span>'}</td>
          <td class="px-4 py-3">${t.jabatan || '-'}</td>
          <td class="px-4 py-3">${t.mapel || '-'}</td>
          <td class="px-4 py-3 text-slate-500">${t.pendidikan || '-'}</td>
          <td class="px-4 py-3">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold ${t.password ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
              <i class="fa-solid fa-key text-[9px]"></i>
              <span>${t.password ? 'Siap Login' : 'Default (guru123)'}</span>
            </span>
          </td>
          <td class="px-4 py-3 text-center space-x-1 whitespace-nowrap">
            <button type="button" onclick="editGuru('${t.id}')" class="p-1.5 text-brand-700 hover:bg-brand-50 rounded-lg transition" title="Edit Data & Password">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button type="button" onclick="deleteGuru('${t.id}')" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition" title="Hapus">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </td>
        </tr>
      `).join('');
      document.getElementById('metricGuru').textContent = currentTeachers.length;
    }

    window.editGuru = function(id) {
      const t = currentTeachers.find(item => String(item.id) === String(id));
      if (!t) return;
      document.getElementById('guruEditId').value = t.id;
      document.getElementById('guruNama').value = t.nama;
      document.getElementById('guruJabatan').value = t.jabatan || '';
      document.getElementById('guruMapel').value = t.mapel || '';
      document.getElementById('guruPendidikan').value = t.pendidikan || '';
      document.getElementById('guruNip').value = t.nip || '';
      document.getElementById('guruPassword').value = t.password || '';
      document.getElementById('teacherPhotoVal').value = t.foto || '/assets/img/teachers/male-1.svg';
      document.getElementById('teacherPhotoPreview').src = t.foto || '/assets/img/teachers/male-1.svg';

      document.getElementById('btnSubmitGuru').innerHTML = `<i class="fa-solid fa-floppy-disk"></i> <span>Perbarui Data Guru</span>`;
      document.getElementById('btnCancelGuruEdit').classList.remove('hidden');
      window.scrollTo({ top: document.getElementById('formGuru').offsetTop - 60, behavior: 'smooth' });
    };

    window.cancelGuruEdit = function() {
      document.getElementById('formGuru').reset();
      document.getElementById('guruEditId').value = '';
      document.getElementById('guruNip').value = '';
      document.getElementById('guruPassword').value = '';
      document.getElementById('teacherPhotoVal').value = '/assets/img/teachers/male-1.svg';
      document.getElementById('teacherPhotoPreview').src = '/assets/img/teachers/male-1.svg';
      document.getElementById('btnSubmitGuru').innerHTML = `<i class="fa-solid fa-user-plus"></i> <span>Simpan Data Guru</span>`;
      document.getElementById('btnCancelGuruEdit').classList.add('hidden');
    };

    window.deleteGuru = async function(id) {
      if (!confirm('Yakin ingin menghapus guru ini?')) return;
      currentTeachers = currentTeachers.filter(t => String(t.id) !== String(id));
      try {
        localStorage.setItem('alkholili_teachers_data', JSON.stringify(currentTeachers));
      } catch (e) {}
      renderTeachers();
      await executeTursoSql(`DELETE FROM guru WHERE id = ?`, [{ type: "text", value: String(id) }]);
      showToast("Data guru berhasil dihapus!");
    };

    // Teacher photo file change
    document.getElementById('inputTeacherPhotoFile')?.addEventListener('change', async function(e) {
      const file = e.target.files[0];
      if (file) {
        const dataUrl = await fileToDataUrl(file, 600);
        document.getElementById('teacherPhotoPreview').src = dataUrl;
        document.getElementById('teacherPhotoVal').value = dataUrl;
      }
    });

    document.getElementById('formGuru')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = document.getElementById('guruEditId').value;
      const id = editId ? editId : `guru-${Date.now()}`;
      const nama = document.getElementById('guruNama').value.trim();
      const jabatan = document.getElementById('guruJabatan').value.trim();
      const mapel = document.getElementById('guruMapel').value.trim();
      const pendidikan = document.getElementById('guruPendidikan').value.trim();
      const nip = document.getElementById('guruNip').value.trim();
      const password = document.getElementById('guruPassword').value.trim() || 'guru123';
      const foto = document.getElementById('teacherPhotoVal').value;

      const teacherObj = { id, nama, jabatan, mapel, pendidikan, foto, nip, password };

      if (editId) {
        currentTeachers = currentTeachers.map(t => String(t.id) === String(editId) ? teacherObj : t);
      } else {
        currentTeachers.push(teacherObj);
      }
      try {
        localStorage.setItem('alkholili_teachers_data', JSON.stringify(currentTeachers));
      } catch (e) {}
      renderTeachers();
      cancelGuruEdit();

      await executeTursoSql(`ALTER TABLE guru ADD COLUMN nip TEXT`).catch(() => {});
      await executeTursoSql(`ALTER TABLE guru ADD COLUMN password TEXT`).catch(() => {});

      await executeTursoSql(
        `INSERT OR REPLACE INTO guru (id, nama, jabatan, mapel, pendidikan, foto, nip, password) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          { type: "text", value: String(id) },
          { type: "text", value: nama },
          { type: "text", value: jabatan },
          { type: "text", value: mapel },
          { type: "text", value: pendidikan },
          { type: "text", value: foto },
          { type: "text", value: nip },
          { type: "text", value: password }
        ]
      );
      showToast("Data guru berhasil disimpan!");
    });

    // ========================================================
    // 12. MANAGE GALERI FOTO
    // ========================================================
    function renderGallery() {
      const container = document.getElementById('galleryGrid');
      if (!container) return;
      container.innerHTML = currentGallery.map(g => `
        <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 group relative">
          <div class="h-36 bg-slate-800 overflow-hidden relative">
            <img src="${g.gambar || g.foto}" class="w-full h-full object-cover group-hover:scale-105 transition" />
            <span class="absolute top-2 left-2 px-2 py-0.5 rounded text-[10px] font-bold bg-brand-900/80 text-white backdrop-blur-sm">
              ${g.kategori_label || g.kategori}
            </span>
          </div>
          <div class="p-3.5 space-y-1">
            <h4 class="font-bold text-slate-800 text-xs truncate">${g.judul}</h4>
            <p class="text-[11px] text-slate-500 line-clamp-1">${g.deskripsi || ''}</p>
            <div class="pt-2 flex justify-end">
              <button type="button" onclick="deleteGaleri(${g.id})" class="text-xs text-red-600 hover:text-red-700 font-bold inline-flex items-center gap-1">
                <i class="fa-solid fa-trash-can text-[10px]"></i> Hapus
              </button>
            </div>
          </div>
        </div>
      `).join('');
      document.getElementById('metricGaleri').textContent = currentGallery.length;
    }

    window.deleteGaleri = async function(id) {
      if (!confirm('Hapus foto ini dari galeri?')) return;
      currentGallery = currentGallery.filter(g => g.id !== id);
      renderGallery();
      await executeTursoSql(`DELETE FROM galeri WHERE id = ?`, [{ type: "text", value: String(id) }]);
      showToast("Foto galeri berhasil dihapus!");
    };

    document.getElementById('inputGaleriPhotoFile')?.addEventListener('change', async function(e) {
      const file = e.target.files[0];
      if (file) {
        const dataUrl = await fileToDataUrl(file, 900);
        document.getElementById('galeriPhotoPreview').src = dataUrl;
        document.getElementById('galeriPhotoVal').value = dataUrl;
      }
    });

    document.getElementById('formGaleri')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = Date.now();
      const judul = document.getElementById('galeriJudul').value.trim();
      const kategori = document.getElementById('galeriKategori').value;
      const deskripsi = document.getElementById('galeriDeskripsi').value.trim();
      const foto = document.getElementById('galeriPhotoVal').value || '/assets/img/hero-bg.svg';

      const katLabels = {
        ibadah: 'Keagamaan & Ibadah',
        tahfidz: 'Tahfidz Qur\'an',
        belajar: 'Belajar Mengajar',
        ekskul: 'Ekstrakurikuler',
        fasilitas: 'Sarana & Fasilitas'
      };

      const newGal = {
        id,
        judul,
        kategori,
        kategori_label: katLabels[kategori] || 'Kegiatan',
        gambar: foto,
        foto: foto,
        deskripsi: deskripsi
      };

      currentGallery.unshift(newGal);
      renderGallery();
      document.getElementById('formGaleri').reset();
      document.getElementById('galeriPhotoPreview').src = '/assets/img/hero-bg.svg';
      document.getElementById('galeriPhotoVal').value = '';

      await executeTursoSql(
        `INSERT INTO galeri (id, judul, kategori, gambar, deskripsi) VALUES (?, ?, ?, ?, ?)`,
        [
          { type: "text", value: String(id) },
          { type: "text", value: judul },
          { type: "text", value: kategori },
          { type: "text", value: foto },
          { type: "text", value: deskripsi }
        ]
      );
      showToast("Foto berhasil ditambahkan ke galeri!");
    });

    // ========================================================
    // 13. MANAGE BERITA SEKOLAH
    // ========================================================
    function renderNews() {
      const container = document.getElementById('newsList');
      if (!container) return;
      container.innerHTML = currentNews.map(n => `
        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50 flex items-start justify-between gap-4">
          <div class="space-y-1">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${n.badge || 'bg-emerald-100 text-emerald-800'}">
              ${n.kategori || 'Berita'}
            </span>
            <h4 class="font-bold text-slate-800 text-sm">${n.judul}</h4>
            <p class="text-xs text-slate-500 line-clamp-2">${n.ringkasan || n.konten || ''}</p>
            <span class="text-[10px] text-slate-400 block">${n.tanggal || ''}</span>
          </div>
          <button type="button" onclick="deleteBerita(${n.id})" class="text-red-600 hover:text-red-700 p-1.5 text-xs">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      `).join('');
      document.getElementById('metricBerita').textContent = currentNews.length;
    }

    window.deleteBerita = async function(id) {
      if (!confirm('Hapus berita ini?')) return;
      currentNews = currentNews.filter(n => n.id !== id);
      renderNews();
      await executeTursoSql(`DELETE FROM berita WHERE id = ?`, [{ type: "text", value: String(id) }]);
      showToast("Berita berhasil dihapus!");
    };

    document.getElementById('formBerita')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = Date.now();
      const judul = document.getElementById('beritaJudul').value.trim();
      const kategori = document.getElementById('beritaKategori').value;
      const ringkasan = document.getElementById('beritaRingkasan').value.trim();

      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      const tanggal = new Date().toLocaleDateString('id-ID', options);

      const newItem = {
        id,
        judul,
        kategori,
        ringkasan,
        konten: ringkasan,
        tanggal,
        penulis: "Humas Sekolah",
        badge: kategori.includes('PPDB') ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'
      };

      currentNews.unshift(newItem);
      renderNews();
      document.getElementById('formBerita').reset();

      await executeTursoSql(
        `INSERT INTO berita (id, judul, kategori, tanggal, penulis, ringkasan) VALUES (?, ?, ?, ?, ?, ?)`,
        [
          { type: "text", value: String(id) },
          { type: "text", value: judul },
          { type: "text", value: kategori },
          { type: "text", value: tanggal },
          { type: "text", value: newItem.penulis },
          { type: "text", value: ringkasan }
        ]
      );
      showToast("Berita berhasil diterbitkan!");
    });

    // ========================================================
    // 14. PENGATURAN WEBSITE
    // ========================================================
    document.getElementById('inputLogoFile')?.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        const url = await fileToDataUrl(file, 400);
        document.getElementById('previewLogo').src = url;
        document.getElementById('settingLogoVal').value = url;
      }
    });

    document.getElementById('inputHeroBgFile')?.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        const url = await fileToDataUrl(file, 1200);
        document.getElementById('previewHeroBg').src = url;
        document.getElementById('settingHeroBgVal').value = url;
      }
    });

    document.getElementById('inputKepsekFile')?.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        const url = await fileToDataUrl(file, 600);
        document.getElementById('previewKepsek').src = url;
        document.getElementById('settingKepsekFotoVal').value = url;
      }
    });

    document.getElementById('formPengaturan')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const updated = {
        site_name: document.getElementById('settingSiteName').value.trim(),
        site_tagline: document.getElementById('settingSiteTagline').value.trim(),
        hero_title: document.getElementById('settingHeroTitle').value.trim(),
        hero_subtitle: document.getElementById('settingHeroSubtitle').value.trim(),
        nama_kepsek: document.getElementById('settingNamaKepsek').value.trim(),
        ppdb_url: document.getElementById('settingPpdbUrl').value.trim(),
        whatsapp_number: document.getElementById('settingWaNum').value.trim(),
        whatsapp_display: document.getElementById('settingWaDisplay').value.trim(),
        alamat: document.getElementById('settingAlamat').value.trim(),
        logo: document.getElementById('settingLogoVal').value,
        hero_bg: document.getElementById('settingHeroBgVal').value,
        kepsek_foto: document.getElementById('settingKepsekFotoVal').value
      };

      await executeTursoSql(
        `UPDATE pengaturan SET site_name = ?, site_tagline = ?, hero_title = ?, hero_subtitle = ?, alamat = ?, whatsapp_number = ?, whatsapp_display = ?, ppdb_url = ?, logo = ?, hero_bg = ?, nama_kepsek = ?, kepsek_foto = ? WHERE id = 1`,
        [
          { type: "text", value: updated.site_name },
          { type: "text", value: updated.site_tagline },
          { type: "text", value: updated.hero_title },
          { type: "text", value: updated.hero_subtitle },
          { type: "text", value: updated.alamat },
          { type: "text", value: updated.whatsapp_number },
          { type: "text", value: updated.whatsapp_display },
          { type: "text", value: updated.ppdb_url },
          { type: "text", value: updated.logo },
          { type: "text", value: updated.hero_bg },
          { type: "text", value: updated.nama_kepsek },
          { type: "text", value: updated.kepsek_foto }
        ]
      );
      showToast("Pengaturan website berhasil disimpan ke database!");
    });

    function renderAll() {
      renderPpdb();
      renderStudents();
      renderTeachers();
      renderGallery();
      renderNews();
    }

    // Init on page load
    checkAuth();
  </script>
</body>
</html>
