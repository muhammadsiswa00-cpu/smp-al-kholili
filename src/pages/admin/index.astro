  <!-- CLIENT-SIDE LOGIC SCRIPT -->
  <script is:inline define:vars={{ 
    initialSettings: siteSettings, 
    initialTeachers: teachers, 
    initialGallery: gallery, 
    initialNews: news, 
    initialPpdb: ppdbList,
    initialStudents: students,
    initialStudentAttendance: studentAttendance,
    initialTeacherAttendance: teacherAttendance,
    tursoEndpoint: `${tursoHttpHost}/v2/pipeline`, 
    tursoBearer: tursoToken 
  }}>
    // 1. STATE INITIALIZATION
    let currentSettings = initialSettings;
    let currentTeachers = initialTeachers;
    let currentGallery = initialGallery;
    let currentNews = initialNews;
    
    // Load PPDB from LocalStorage merged with initial
    let currentPpdb = initialPpdb;
    try {
      const localPpdb = JSON.parse(localStorage.getItem('alkholili_ppdb_submissions') || '[]');
      if (localPpdb && localPpdb.length > 0) {
        // Merge without duplicates
        const ids = new Set(localPpdb.map(p => p.id));
        currentPpdb = [...localPpdb, ...initialPpdb.filter(p => !ids.has(p.id))];
      }
    } catch (e) {
      console.warn("Local PPDB read warning:", e);
    }

    // Load Students from LocalStorage merged with initial
    let currentStudents = initialStudents;
    try {
      const localStudents = JSON.parse(localStorage.getItem('alkholili_students_data') || '[]');
      if (localStudents && localStudents.length > 0) {
        const ids = new Set(localStudents.map(s => s.id));
        currentStudents = [...localStudents, ...initialStudents.filter(s => !ids.has(s.id))];
      }
    } catch (e) {}

    // Load Attendances
    let currentStudentAttendance = initialStudentAttendance;
    try {
      const localAttS = JSON.parse(localStorage.getItem('alkholili_attendance_students') || '[]');
      if (localAttS && localAttS.length > 0) currentStudentAttendance = localAttS;
    } catch (e) {}

    let currentTeacherAttendance = initialTeacherAttendance;
    try {
      const localAttG = JSON.parse(localStorage.getItem('alkholili_attendance_teachers') || '[]');
      if (localAttG && localAttG.length > 0) currentTeacherAttendance = localAttG;
    } catch (e) {}

    let selectedPpdbItem = null;
    let currentLoginRole = 'admin';

    // 2. AUTHENTICATION & LOGIN
    window.setLoginRole = function(role) {
      currentLoginRole = role;
      const btnAdmin = document.getElementById('roleBtnAdmin');
      const btnGuru = document.getElementById('roleBtnGuru');
      const loginRoleTitle = document.getElementById('loginRoleTitle');
      const loginRoleSub = document.getElementById('loginRoleSub');
      const usernameLabel = document.getElementById('usernameLabel');
      const passwordLabel = document.getElementById('passwordLabel');
      const submitText = document.getElementById('submitBtnText');
      const adminUsername = document.getElementById('adminUsername');
      const adminPassword = document.getElementById('adminPassword');
      const loginAlert = document.getElementById('loginAlert');
      if (loginAlert) loginAlert.classList.add('hidden');

      if (role === 'guru') {
        if (btnGuru) btnGuru.className = "flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 bg-brand-700 text-white shadow-sm";
        if (btnAdmin) btnAdmin.className = "flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900";
        if (loginRoleTitle) loginRoleTitle.textContent = "Portal Dewan Guru";
        if (loginRoleSub) loginRoleSub.textContent = "Akses Data Siswa, Absen Siswa & Absen Guru";
        if (usernameLabel) usernameLabel.textContent = "Username Guru";
        if (passwordLabel) passwordLabel.textContent = "Password Guru";
        if (adminUsername) adminUsername.placeholder = "Masukkan username guru";
        if (adminPassword) adminPassword.placeholder = "Masukkan password guru";
        if (submitText) submitText.textContent = "Masuk sebagai Dewan Guru";
      } else {
        if (btnAdmin) btnAdmin.className = "flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 bg-brand-700 text-white shadow-sm";
        if (btnGuru) btnGuru.className = "flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900";
        if (loginRoleTitle) loginRoleTitle.textContent = "Login Administrator";
        if (loginRoleSub) loginRoleSub.textContent = "Akses penuh pengelolaan website & data akademik";
        if (usernameLabel) usernameLabel.textContent = "Username Admin";
        if (passwordLabel) passwordLabel.textContent = "Password Admin";
        if (adminUsername) adminUsername.placeholder = "Masukkan username admin";
        if (adminPassword) adminPassword.placeholder = "Masukkan password admin";
        if (submitText) submitText.textContent = "Masuk ke Panel Kendali";
      }
    };

    function applyRoleMode(role) {
      const sidebarBadge = document.getElementById('sidebarRoleBadge');
      const headerRoleBadge = document.getElementById('headerRoleBadge');
      const adminOnlyElements = document.querySelectorAll('[data-role-access="admin-only"]');

      if (role === 'guru') {
        if (sidebarBadge) {
          sidebarBadge.textContent = "Portal Dewan Guru";
          sidebarBadge.className = "text-[10px] text-emerald-300 font-bold uppercase tracking-wider";
        }
        if (headerRoleBadge) {
          headerRoleBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span>Guru Aktif</span>';
        }
        adminOnlyElements.forEach(el => {
          el.style.display = 'none';
        });

        // Redirect to tab-siswa if on admin-only tab
        const currentActiveBtn = document.querySelector('.tab-btn.active');
        const activeTabId = currentActiveBtn?.getAttribute('data-tab');
        if (!activeTabId || activeTabId === 'tab-dashboard' || activeTabId === 'tab-ppdb' || activeTabId === 'tab-guru' || activeTabId === 'tab-galeri' || activeTabId === 'tab-berita' || activeTabId === 'tab-pengaturan') {
          switchTab('tab-siswa');
        }
      } else {
        // Admin role
        if (sidebarBadge) {
          sidebarBadge.textContent = "Panel Administrator";
          sidebarBadge.className = "text-[10px] text-gold-400 font-bold uppercase tracking-wider";
        }
        if (headerRoleBadge) {
          headerRoleBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span>Admin Penuh</span>';
        }
        adminOnlyElements.forEach(el => {
          el.style.display = '';
        });
        const currentActiveBtn = document.querySelector('.tab-btn.active');
        const activeTabId = currentActiveBtn?.getAttribute('data-tab') || 'tab-dashboard';
        switchTab(activeTabId);
      }
    }

    function checkAuth() {
      const authed = sessionStorage.getItem('alkholili_admin_auth') === 'true';
      const role = sessionStorage.getItem('alkholili_user_role') || 'admin';
      const loginSection = document.getElementById('loginSection');
      const dashboardSection = document.getElementById('dashboardSection');

      if (authed) {
        if (loginSection) {
          loginSection.classList.add('hidden');
          loginSection.style.display = 'none';
        }
        if (dashboardSection) {
          dashboardSection.classList.remove('hidden');
          dashboardSection.style.display = 'flex';
        }
        applyRoleMode(role);
        renderAll();
      } else {
        if (loginSection) {
          loginSection.classList.remove('hidden');
          loginSection.style.display = 'flex';
        }
        if (dashboardSection) {
          dashboardSection.classList.add('hidden');
          dashboardSection.style.display = 'none';
        }
      }
    }

    // Toggle Password Visibility
    const togglePassBtn = document.getElementById('togglePasswordBtn');
    const passInput = document.getElementById('adminPassword');
    const passIcon = document.getElementById('togglePasswordIcon');
    togglePassBtn?.addEventListener('click', () => {
      if (passInput.type === 'password') {
        passInput.type = 'text';
        passIcon.className = 'fa-regular fa-eye-slash text-sm';
      } else {
        passInput.type = 'password';
        passIcon.className = 'fa-regular fa-eye text-sm';
      }
    });

    document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const u = document.getElementById('adminUsername').value.trim();
      const p = document.getElementById('adminPassword').value.trim();
      const alertBox = document.getElementById('loginAlert');
      const alertMsg = document.getElementById('loginAlertMsg');

      let authenticatedRole = null;

      if (currentLoginRole === 'guru') {
        // Login as Guru
        const validGuruUsers = ['guru', 'dewan guru', 'guru al-kholili', 'smp al-kholili', 'admin'];
        const validGuruPasses = ['guru', 'guru123', 'al-kholili', 'admin123'];
        if (validGuruPasses.includes(p) || validGuruUsers.includes(u.toLowerCase())) {
          authenticatedRole = 'guru';
        }
      } else {
        // Login as Admin
        const validAdminUsers = ['smp al-kholili', 'admin'];
        const validAdminPasses = ['al-kholili', 'admin123'];
        if (validAdminUsers.includes(u.toLowerCase()) && validAdminPasses.includes(p)) {
          authenticatedRole = 'admin';
        }
      }

      if (authenticatedRole) {
        sessionStorage.setItem('alkholili_admin_auth', 'true');
        sessionStorage.setItem('alkholili_user_role', authenticatedRole);
        document.getElementById('adminUsername').value = '';
        document.getElementById('adminPassword').value = '';
        if (alertBox) alertBox.classList.add('hidden');
        checkAuth();
        showToast(authenticatedRole === 'guru' ? "Selamat datang di Portal Dewan Guru!" : "Login Administrator Berhasil!", "success");
      } else {
        if (alertMsg) {
          alertMsg.textContent = (currentLoginRole === 'guru')
            ? "Username atau password guru salah! Silakan coba lagi."
            : "Username atau password administrator salah! Silakan coba lagi.";
        }
        if (alertBox) alertBox.classList.remove('hidden');
      }
    });

    window.adminLogout = function() {
      if (confirm('Yakin ingin keluar dari panel?')) {
        sessionStorage.removeItem('alkholili_admin_auth');
        sessionStorage.removeItem('alkholili_user_role');
        document.getElementById('adminUsername').value = '';
        document.getElementById('adminPassword').value = '';
        checkAuth();
      }
    };

    // 3. TOAST MESSAGES
    function showToast(msg, type = "success") {
      const toast = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      if (!toast) return;
      toastMsg.textContent = msg;

      if (type === "success") {
        toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-lg";
      } else {
        toastIcon.className = "fa-solid fa-circle-exclamation text-red-400 text-lg";
      }

      toast.classList.remove('translate-y-[-150%]');
      toast.classList.add('translate-y-0');
      toast.classList.add('show-toast');

      setTimeout(() => {
        toast.classList.remove('translate-y-0');
        toast.classList.remove('show-toast');
        toast.classList.add('translate-y-[-150%]');
      }, 3500);
    }

    // 4. TAB NAVIGATION
    window.switchTab = function(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => {
        el.classList.add('hidden');
        el.style.display = 'none';
      });
      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('active', 'bg-brand-900', 'text-white');
        el.classList.add('text-slate-300');
      });

      const activeSection = document.getElementById(tabId);
      if (activeSection) {
        activeSection.classList.remove('hidden');
        activeSection.style.display = 'block';
      }
      const activeBtn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
      if (activeBtn) {
        activeBtn.classList.add('active', 'bg-brand-900', 'text-white');
        activeBtn.classList.remove('text-slate-300');
      }

      const titles = {
        'tab-dashboard': 'Ringkasan Dasbor',
        'tab-ppdb': 'Data Masuk & Berkas PPDB Online',
        'tab-siswa': 'Manajemen Data Siswa',
        'tab-absen-siswa': 'Presensi & Absensi Siswa Harian',
        'tab-absen-guru': 'Presensi & Absensi Dewan Guru',
        'tab-guru': 'Kelola Data & Foto Dewan Guru',
        'tab-galeri': 'Upload & Dokumentasi Galeri Kegiatan',
        'tab-berita': 'Publikasi Berita Sekolah',
        'tab-pengaturan': 'Pengaturan Tampilan & Website'
      };
      document.getElementById('tabTitle').textContent = titles[tabId] || 'Panel Administrator';

      if (tabId === 'tab-siswa') renderStudents();
      if (tabId === 'tab-absen-siswa') initStudentAttendanceTab();
      if (tabId === 'tab-absen-guru') initTeacherAttendanceTab();
      if (tabId === 'tab-ppdb') renderPpdb();
    };

    // 5. LIGHTBOX MODAL
    window.openLightbox = function(imgSrc, title) {
      if (!imgSrc) return;
      document.getElementById('lightboxImg').src = imgSrc;
      document.getElementById('lightboxTitle').textContent = title || 'Pratinjau Berkas Dokumen';
      document.getElementById('lightboxDownloadBtn').href = imgSrc;
      document.getElementById('lightboxModal').classList.remove('hidden');
    };

    window.closeLightbox = function() {
      document.getElementById('lightboxModal').classList.add('hidden');
      document.getElementById('lightboxImg').src = '';
    };

    // 6. TURSO SQL EXECUTOR HELPER
    async function executeTursoSql(sql, args = []) {
      try {
        const payload = {
          requests: [
            { type: "execute", stmt: { sql, args } },
            { type: "close" }
          ]
        };
        const res = await fetch(tursoEndpoint, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${tursoBearer}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });
        return await res.json();
      } catch (err) {
        console.warn("Turso execute failed, will fallback to local storage:", err);
        return null;
      }
    }

    // Helper: compress image file to Data URL
    function fileToDataUrl(file, maxDimension = 800) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const raw = e.target.result;
          if (!file.type.startsWith('image/')) {
            resolve(raw);
            return;
          }
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            let w = img.width;
            let h = img.height;
            if (w > maxDimension || h > maxDimension) {
              if (w > h) {
                h = Math.round((h * maxDimension) / w);
                w = maxDimension;
              } else {
                w = Math.round((w * maxDimension) / h);
                h = maxDimension;
              }
            }
            canvas.width = w;
            canvas.height = h;
            ctx.drawImage(img, 0, 0, w, h);
            resolve(canvas.toDataURL('image/jpeg', 0.8));
          };
          img.onerror = () => resolve(raw);
          img.src = raw;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    // ========================================================
    // 7. MANAGE PPDB SUBMISSIONS & BERKAS
    // ========================================================
    function renderPpdb() {
      const container = document.getElementById('ppdbTableBody');
      if (!container) return;

      const search = (document.getElementById('searchPpdbInput')?.value || '').toLowerCase();
      const statusFilter = document.getElementById('filterPpdbStatus')?.value || 'all';
      const jalurFilter = document.getElementById('filterPpdbJalur')?.value || 'all';

      const filtered = currentPpdb.filter(p => {
        const matchSearch = (p.nama || p.nama_lengkap || '').toLowerCase().includes(search) ||
                            (p.id || '').toLowerCase().includes(search) ||
                            (p.asal_sekolah || '').toLowerCase().includes(search);
        const matchStatus = statusFilter === 'all' || p.status === statusFilter;
        const matchJalur = jalurFilter === 'all' || (p.jalur || 'Reguler') === jalurFilter;
        return matchSearch && matchStatus && matchJalur;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<tr><td colspan="7" class="px-4 py-8 text-center text-slate-400">Tidak ada data pendaftar yang cocok dengan filter.</td></tr>`;
      } else {
        container.innerHTML = filtered.map(p => {
          const docsCount = [p.berkas_akta, p.berkas_ktp, p.berkas_foto, p.berkas_rapor, p.berkas_skl].filter(Boolean).length;
          const statusBg = p.status === 'Diterima' ? 'bg-emerald-100 text-emerald-800' :
                           (p.status === 'Ditolak' ? 'bg-red-100 text-red-800' : 
                           (p.status === 'Cadangan' ? 'bg-purple-100 text-purple-800' : 'bg-amber-100 text-amber-800'));
          
          return `
            <tr class="hover:bg-slate-50 transition">
              <td class="px-4 py-3">
                <span class="font-mono font-bold text-brand-800 block">${p.id || p.no_pendaftaran || '-'}</span>
                <span class="text-[10px] text-slate-400">${p.waktu || p.created_at || '-'}</span>
              </td>
              <td class="px-4 py-3">
                <strong class="text-slate-900 block font-semibold">${p.nama || p.nama_lengkap || '-'}</strong>
                <span class="text-[11px] text-slate-400">NISN: ${p.nisn || '-'} | ${p.jenis_kelamin || '-'}</span>
              </td>
              <td class="px-4 py-3">
                <span class="text-slate-800 block">${p.asal_sekolah || '-'}</span>
                <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700 mt-0.5">${p.jalur || 'Reguler'}</span>
              </td>
              <td class="px-4 py-3">
                <a href="https://wa.me/${(p.no_wa || p.no_whatsapp || '').replace(/[^0-9]/g, '')}" target="_blank" class="text-brand-700 hover:underline font-bold inline-flex items-center gap-1">
