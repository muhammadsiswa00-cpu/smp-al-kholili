---
import '../../styles/global.css';
import { 
  getSiteSettings, 
  getTeachers, 
  getGallery, 
  getNews, 
  getPpdbList,
  getStudents,
  getStudentAttendance,
  getTeacherAttendance
} from '../../lib/data';

const siteSettings = await getSiteSettings();
const teachers = await getTeachers();
const gallery = await getGallery();
const news = await getNews();
const ppdbList = await getPpdbList();
const students = await getStudents();
const studentAttendance = await getStudentAttendance();
const teacherAttendance = await getTeacherAttendance();

const tursoUrl = process.env.TURSO_DATABASE_URL || 'libsql://smp-memet.aws-ap-southeast-1.turso.io';
const tursoToken = process.env.TURSO_AUTH_TOKEN || 'eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTU0MDY0NzYsImlkIjoiMDFhMjA2NzktM2EwMS03ZTJhLWJhNzUtMjg1NTA1YTA1YmM5Iiwia2lkIjoiUUFlRERrU0pVQTJoZl9TTjRWaE9ZTUFrT1g2MUV3VWo0YS1qYllhZHYwcyIsInJpZCI6ImNlNWM2ODdjLTRhYzQtNDFkYS1hN2VkLWRiZDI0NTU2MjJiZSJ9.6u2b8t47piQWRWs-SvW1LgHUgqMd5V5ev1ZM2YHZCA9sSkjXs1VxeYt6n_fDuQpnchgJKhMqcciS26plEWFPCQ';
const tursoHttpHost = tursoUrl.replace(/^libsql:\/\//, 'https://');
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel Administrator - SMP Islam Al-Kholili</title>
  <link rel="icon" type="image/png" href={siteSettings.logo || "/assets/img/logo.png"} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
              900: '#064e3b',
              950: '#022c22',
            },
            gold: {
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706',
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            heading: ['"Outfit"', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style is:inline>
    /* Resilient Standalone Fallback Styles */
    .hidden,
    #dashboardSection.hidden,
    #loginSection.hidden {
      display: none !important;
    }
    #toastNotification {
      position: fixed !important;
      top: 1.5rem;
      right: 1.5rem;
      z-index: 99999;
      transform: translateY(-200%);
      transition: transform 0.3s ease;
      pointer-events: none;
    }
    #toastNotification.show-toast {
      transform: translateY(0) !important;
    }
    #loginSection {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #022c22 0%, #064e3b 60%, #0f172a 100%);
      padding: 1.5rem;
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }
    #loginSection .login-card {
      width: 100%;
      max-width: 28rem;
      background: #ffffff;
      border-radius: 1.5rem;
      padding: 2.25rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
      position: relative;
      overflow: hidden;
    }
  </style>
</head>
<body class="bg-slate-100 font-sans text-slate-800 antialiased min-h-screen">

  <!-- TOAST NOTIFICATION -->
  <div id="toastNotification" class="fixed top-6 right-6 z-50 transform translate-y-[-150%] transition-transform duration-300 pointer-events-none">
    <div class="bg-slate-900/95 backdrop-blur-md text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-slate-700/80 flex items-center gap-3">
      <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
      <span id="toastMsg" class="text-xs font-semibold">Tersimpan</span>
    </div>
  </div>

  <!-- LIGHTBOX IMAGE PREVIEW MODAL -->
  <div id="lightboxModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="relative max-w-4xl w-full bg-slate-900 rounded-2xl overflow-hidden shadow-2xl p-4 space-y-3">
      <div class="flex items-center justify-between text-white border-b border-slate-800 pb-2">
        <h4 id="lightboxTitle" class="text-sm font-bold">Pratinjau Berkas Dokumen</h4>
        <button type="button" onclick="closeLightbox()" class="text-slate-400 hover:text-white p-1 text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="flex items-center justify-center max-h-[75vh] overflow-auto bg-black/40 rounded-xl p-2">
        <img id="lightboxImg" src="" alt="Preview" class="max-w-full max-h-[70vh] object-contain rounded-lg" />
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <a id="lightboxDownloadBtn" href="#" download="berkas_ppdb.jpg" class="px-4 py-2 bg-brand-700 hover:bg-brand-800 text-white rounded-xl text-xs font-bold flex items-center gap-2">
          <i class="fa-solid fa-download"></i> <span>Unduh Dokumen</span>
        </a>
        <button type="button" onclick="closeLightbox()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-bold">
          Tutup
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 1. LOGIN SCREEN (Visible if NOT authenticated) -->
  <!-- ========================================================================= -->
  <div id="loginSection" class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-brand-950 via-brand-900 to-slate-900" style="display: flex;">
    <div class="login-card w-full max-w-md bg-white rounded-3xl shadow-2xl p-8 sm:p-10 border border-slate-100 relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-brand-600 via-gold-400 to-emerald-500"></div>

      <!-- Role Selection Switcher -->
      <div class="flex items-center p-1 bg-slate-100 rounded-2xl mb-6 border border-slate-200">
        <button type="button" id="roleBtnAdmin" onclick="setLoginRole('admin')" class="flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 bg-brand-700 text-white shadow-sm">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Sebagai Admin</span>
        </button>
        <button type="button" id="roleBtnGuru" onclick="setLoginRole('guru')" class="flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900">
          <i class="fa-solid fa-chalkboard-user"></i>
          <span>Sebagai Guru</span>
        </button>
      </div>

      <div class="text-center mb-6">
        <div class="w-16 h-16 mx-auto p-1 bg-gradient-to-tr from-brand-700 to-gold-400 rounded-2xl shadow-lg mb-3 flex items-center justify-center">
          <img src={siteSettings.logo || "/assets/img/logo.png"} alt="Logo SMP Islam Al-Kholili" class="w-full h-full object-contain bg-white rounded-xl p-1" />
        </div>
        <h1 id="loginRoleTitle" class="text-2xl font-heading font-extrabold text-slate-900">Login Administrator</h1>
        <p class="text-xs text-brand-700 font-bold uppercase tracking-wider mt-1">SMP ISLAM AL-KHOLILI</p>
        <p id="loginRoleSub" class="text-xs text-slate-500 mt-1">Akses penuh pengelolaan website & data akademik</p>
      </div>

      <div id="loginAlert" class="hidden mb-5 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center gap-2">
        <i class="fa-solid fa-circle-exclamation text-base flex-shrink-0"></i>
        <span id="loginAlertMsg">Username atau password salah!</span>
      </div>

      <form id="loginForm" class="space-y-4">
        <div>
          <label id="usernameLabel" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" for="adminUsername">Username Admin</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
              <i class="fa-solid fa-user text-sm"></i>
            </span>
            <input type="text" id="adminUsername" required autocomplete="username" class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-600 text-sm" placeholder="Masukkan username admin" />
          </div>
        </div>

        <div>
          <label id="passwordLabel" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" for="adminPassword">Password Admin</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
              <i class="fa-solid fa-lock text-sm"></i>
            </span>
            <input type="password" id="adminPassword" required autocomplete="current-password" class="w-full pl-10 pr-10 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-600 text-sm" placeholder="Masukkan password admin" />
            <button type="button" id="togglePasswordBtn" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none" aria-label="Toggle password visibility">
              <i class="fa-regular fa-eye text-sm" id="togglePasswordIcon"></i>
            </button>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" class="w-full py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-brand-700 to-emerald-600 hover:from-brand-800 transition shadow-lg shadow-brand-700/30 flex items-center justify-center gap-2 text-sm">
            <i class="fa-solid fa-right-to-bracket"></i>
            <span id="submitBtnText">Masuk ke Panel Kendali</span>
          </button>
        </div>
      </form>

      <div class="mt-7 pt-4 border-t border-slate-100 text-center">
        <a href="/" class="text-xs text-brand-700 hover:underline font-semibold inline-flex items-center gap-1.5">
          <i class="fa-solid fa-arrow-left"></i> Kembali ke Website Utama
        </a>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 2. MAIN ADMIN DASHBOARD (Visible if authenticated) -->
  <!-- ========================================================================= -->
  <div id="dashboardSection" class="hidden min-h-screen flex flex-col md:flex-row" style="display: none;">
    
    <!-- Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-brand-950 text-slate-300 border-r border-brand-800/60 p-5 space-y-6 flex-shrink-0 flex flex-col justify-between">
      <div class="space-y-6">
        <!-- Brand Header -->
        <div class="flex items-center gap-3 pb-5 border-b border-brand-800/80">
          <div class="w-12 h-12 p-1 bg-white rounded-xl shadow flex items-center justify-center flex-shrink-0">
            <img src={siteSettings.logo || "/assets/img/logo.png"} alt="Logo" class="w-full h-full object-contain" />
          </div>
          <div class="min-w-0">
            <h2 class="text-white font-heading font-extrabold text-sm leading-tight truncate">SMP ISLAM AL-KHOLILI</h2>
            <span id="sidebarRoleBadge" class="text-[10px] text-gold-400 font-bold uppercase tracking-wider">Panel Administrator</span>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="space-y-1.5 text-xs font-semibold">
          <button type="button" data-role-access="admin-only" onclick="switchTab('tab-dashboard')" class="tab-btn active w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-dashboard">
            <i class="fa-solid fa-chart-pie w-5 text-center text-gold-400"></i>
            <span>Ringkasan Dasbor</span>
          </button>

          <!-- PPDB ONLINE (ENHANCED) -->
          <button type="button" data-role-access="admin-only" onclick="switchTab('tab-ppdb')" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-ppdb">
            <i class="fa-solid fa-user-graduate w-5 text-center text-gold-400"></i>
            <div class="flex-1">
              <span>Data Masuk PPDB</span>
              <span class="block text-[10px] text-emerald-300 font-normal">Berkas & Seleksi Siswa</span>
            </div>
          </button>

          <!-- DATA SISWA (GURU & ADMIN) -->
          <button type="button" data-role-access="all" onclick="switchTab('tab-siswa')" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-siswa">
            <i class="fa-solid fa-id-card-clip w-5 text-center text-gold-400"></i>
            <div class="flex-1">
              <span>Data Siswa</span>
              <span class="block text-[10px] text-emerald-300 font-normal">Kelas VII, VIII, IX</span>
            </div>
          </button>

          <!-- ABSEN SISWA (GURU & ADMIN) -->
          <button type="button" data-role-access="all" onclick="switchTab('tab-absen-siswa')" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-absen-siswa">
            <i class="fa-solid fa-clipboard-user w-5 text-center text-gold-400"></i>
            <div class="flex-1">
              <span>Absen Siswa</span>
              <span class="block text-[10px] text-emerald-300 font-normal">Pencatatan Kehadiran</span>
            </div>
          </button>

          <!-- ABSEN GURU (GURU & ADMIN) -->
          <button type="button" data-role-access="all" onclick="switchTab('tab-absen-guru')" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-absen-guru">
            <i class="fa-solid fa-user-check w-5 text-center text-gold-400"></i>
            <div class="flex-1">
              <span>Absen Guru</span>
              <span class="block text-[10px] text-emerald-300 font-normal">Presensi Tenaga Pendidik</span>
            </div>
          </button>

          <button type="button" data-role-access="admin-only" onclick="switchTab('tab-guru')" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-guru">
            <i class="fa-solid fa-chalkboard-user w-5 text-center text-gold-400"></i>
            <span>Data & Foto Guru</span>
          </button>

          <button type="button" data-role-access="admin-only" onclick="switchTab('tab-galeri')" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-galeri">
            <i class="fa-solid fa-images w-5 text-center text-gold-400"></i>
            <span>Upload Galeri Foto</span>
          </button>

          <button type="button" data-role-access="admin-only" onclick="switchTab('tab-berita')" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-berita">
            <i class="fa-solid fa-newspaper w-5 text-center text-gold-400"></i>
            <span>Berita Sekolah</span>
          </button>

          <button type="button" data-role-access="admin-only" onclick="switchTab('tab-pengaturan')" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition text-left" data-tab="tab-pengaturan">
            <i class="fa-solid fa-sliders w-5 text-center text-gold-400"></i>
            <div class="flex-1">
              <span>Pengaturan Website</span>
              <span class="block text-[10px] text-emerald-300 font-normal">Logo, Begrond & Kontak</span>
            </div>
          </button>
        </nav>
      </div>

      <!-- Quick Links & Logout -->
      <div class="pt-5 border-t border-brand-800/80 space-y-2 text-xs">
        <a href="/" target="_blank" class="w-full flex items-center justify-between px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-emerald-200 transition">
          <span class="flex items-center gap-2"><i class="fa-solid fa-globe"></i> Buka Website</span>
          <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
        </a>
        <button type="button" onclick="adminLogout()" class="w-full flex items-center gap-2 px-3.5 py-2 rounded-xl bg-red-950/60 hover:bg-red-900 text-red-200 transition">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Keluar (Logout)</span>
        </button>
      </div>
    </aside>

    <!-- Main Content Container -->
    <main class="flex-1 flex flex-col min-w-0">
      
      <!-- Topbar Header -->
      <header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between shadow-sm">
        <div>
          <h1 id="tabTitle" class="font-heading font-extrabold text-xl text-slate-800">Ringkasan Dasbor</h1>
          <p class="text-xs text-slate-500">Panel Kendali Modern & Database Terpadu</p>
        </div>
        <div class="flex items-center gap-3">
          <span id="headerRoleBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Admin Penuh</span>
          </span>
          <a href="/ppdb" data-role-access="admin-only" target="_blank" class="text-xs font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 px-3 py-1.5 rounded-lg transition inline-flex items-center gap-1.5">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>Form PPDB Publik</span>
          </a>
        </div>
      </header>

      <!-- Dynamic Tab Bodies -->
      <div class="p-6 md:p-8 flex-1 overflow-y-auto space-y-6">

        <!-- ========================================== -->
        <!-- TAB 1: DASBOR OVERVIEW -->
        <!-- ========================================== -->
        <div id="tab-dashboard" class="tab-content space-y-6">
          <div class="bg-gradient-to-r from-brand-900 via-brand-800 to-emerald-900 rounded-3xl p-6 sm:p-8 text-white shadow-lg relative overflow-hidden">
            <div class="relative z-10 space-y-2">
              <span class="inline-block px-3 py-1 rounded-full bg-gold-400 text-brand-950 text-xs font-bold uppercase tracking-wider">
                Administrator Panel
              </span>
              <h2 class="text-2xl sm:text-3xl font-heading font-extrabold">
                Selamat Datang di Dasbor Kontrol Sekolah
              </h2>
              <p class="text-emerald-100 text-xs sm:text-sm max-w-2xl leading-relaxed">
                Kelola data formulir PPDB online beserta berkas dokumen calon siswa, pantau data siswa aktif per kelas, serta catat presensi harian siswa dan dewan guru dengan mudah dan cepat.
              </p>
            </div>
          </div>

          <!-- Quick Metrics -->
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-1">
              <div class="w-9 h-9 rounded-xl bg-amber-50 text-gold-600 flex items-center justify-center text-lg">
                <i class="fa-solid fa-user-graduate"></i>
              </div>
              <span class="text-[11px] text-slate-400 font-bold uppercase block">Pendaftar PPDB</span>
              <strong id="metricPpdb" class="text-xl text-slate-900 font-heading block">{ppdbList.length}</strong>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-1">
              <div class="w-9 h-9 rounded-xl bg-emerald-50 text-brand-700 flex items-center justify-center text-lg">
                <i class="fa-solid fa-id-card-clip"></i>
              </div>
              <span class="text-[11px] text-slate-400 font-bold uppercase block">Total Siswa</span>
              <strong id="metricSiswa" class="text-xl text-slate-900 font-heading block">{students.length}</strong>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-1">
              <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
                <i class="fa-solid fa-chalkboard-user"></i>
              </div>
              <span class="text-[11px] text-slate-400 font-bold uppercase block">Dewan Guru</span>
              <strong id="metricGuru" class="text-xl text-slate-900 font-heading block">{teachers.length}</strong>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-1">
              <div class="w-9 h-9 rounded-xl bg-green-50 text-green-600 flex items-center justify-center text-lg">
                <i class="fa-solid fa-clipboard-user"></i>
              </div>
              <span class="text-[11px] text-slate-400 font-bold uppercase block">Absen Siswa</span>
              <strong id="metricAbsenSiswa" class="text-xl text-slate-900 font-heading block">{studentAttendance.length}</strong>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-1">
              <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-lg">
                <i class="fa-solid fa-user-check"></i>
              </div>
              <span class="text-[11px] text-slate-400 font-bold uppercase block">Absen Guru</span>
              <strong id="metricAbsenGuru" class="text-xl text-slate-900 font-heading block">{teacherAttendance.length}</strong>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-1">
              <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg">
                <i class="fa-solid fa-newspaper"></i>
              </div>
              <span class="text-[11px] text-slate-400 font-bold uppercase block">Berita / Info</span>
              <strong id="metricBerita" class="text-xl text-slate-900 font-heading block">{news.length}</strong>
            </div>
          </div>

          <!-- Quick Navigation Shortcuts -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <button onclick="switchTab('tab-ppdb')" class="p-5 bg-white rounded-2xl border border-slate-200 shadow-sm hover:border-brand-600 hover:shadow-md transition text-left group">
              <div class="w-10 h-10 rounded-xl bg-amber-50 text-gold-600 flex items-center justify-center mb-3 group-hover:bg-gold-500 group-hover:text-white transition">
                <i class="fa-solid fa-folder-open"></i>
              </div>
              <h3 class="font-heading font-bold text-slate-900 text-sm">Verifikasi Berkas PPDB</h3>
              <p class="text-xs text-slate-500 mt-1">Lihat foto akta, KTP, pas foto 3x4, rapor, dan SKL pendaftar baru.</p>
            </button>

            <button onclick="switchTab('tab-siswa')" class="p-5 bg-white rounded-2xl border border-slate-200 shadow-sm hover:border-brand-600 hover:shadow-md transition text-left group">
