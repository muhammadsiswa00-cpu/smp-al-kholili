    // 10.2 DETEKSI LOKASI GEOLOCATION (GPS)
    window.detectGuruLocation = function() {
      const card = document.getElementById('gpsStatusCard');
      const dot = document.getElementById('gpsIndicatorDot');
      const title = document.getElementById('gpsStatusTitle');
      const desc = document.getElementById('gpsStatusDesc');
      const distVal = document.getElementById('gpsDistanceVal');

      if (!navigator.geolocation) {
        if (dot) dot.className = "w-3 h-3 rounded-full bg-red-500";
        if (title) title.textContent = "Geolocation Tidak Didukung Browser";
        if (desc) desc.textContent = "Gunakan browser modern (Chrome/Firefox/Edge/Safari) pada smartphone atau laptop yang mendukung GPS.";
        isLocationValid = isGpsDemoMode;
        return;
      }

      if (dot) dot.className = "w-3 h-3 rounded-full bg-amber-500 animate-pulse";
      if (title) title.textContent = "Mendeteksi Titik GPS...";
      if (desc) desc.textContent = "Menghubungkan ke satelit GPS perangkat Anda untuk mengukur jarak ke lokasi SMP Islam Al-Kholili...";

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          currentGpsCoords = {
            lat: pos.coords.latitude,
            lng: pos.coords.longitude
          };
          const dist = calculateDistance(pos.coords.latitude, pos.coords.longitude, SCHOOL_COORDS.lat, SCHOOL_COORDS.lng);
          currentDistanceToSchool = dist;
          if (distVal) distVal.textContent = `${dist} Meter`;

          if (dist <= SCHOOL_COORDS.radiusMeters || isGpsDemoMode) {
            isLocationValid = true;
            if (card) card.className = "p-4 rounded-xl border bg-emerald-50 border-emerald-300 space-y-2.5";
            if (dot) dot.className = "w-3 h-3 rounded-full bg-emerald-500";
            if (title) title.textContent = isGpsDemoMode && dist > SCHOOL_COORDS.radiusMeters 
              ? "Lokasi Valid (Mode Simulasi Uji Coba Aktif)" 
              : "Lokasi Valid: Berada di Lingkungan Sekolah";
            if (desc) desc.innerHTML = `<span class="text-emerald-800 font-semibold">Koordinat: ${pos.coords.latitude.toFixed(5)}, ${pos.coords.longitude.toFixed(5)}. Jarak: <strong>${dist} meter</strong> dari gerbang sekolah (Radius maks: 200m). Presensi diizinkan!</span>`;
          } else {
            isLocationValid = false;
            if (card) card.className = "p-4 rounded-xl border bg-rose-50 border-rose-300 space-y-2.5";
            if (dot) dot.className = "w-3 h-3 rounded-full bg-rose-500";
            if (title) title.textContent = "Di Luar Radius Sekolah (Presensi Ditolak)";
            if (desc) desc.innerHTML = `<span class="text-rose-800 font-semibold">Jarak Anda terdeteksi <strong>${dist} meter</strong> dari SMP Islam Al-Kholili. Batas maksimal absensi adalah 200 meter. Anda tidak dapat melakukan absensi di luar lingkungan sekolah!</span>`;
          }
        },
        (err) => {
          console.warn("GPS detection failed:", err);
          if (isGpsDemoMode) {
            isLocationValid = true;
            if (card) card.className = "p-4 rounded-xl border bg-emerald-50 border-emerald-300 space-y-2.5";
            if (dot) dot.className = "w-3 h-3 rounded-full bg-emerald-500";
            if (title) title.textContent = "Mode Simulasi GPS Aktif";
            if (desc) desc.textContent = "Lokasi disetujui untuk tujuan demonstrasi dan uji coba.";
            if (distVal) distVal.textContent = "15 Meter (Simulasi)";
          } else {
            isLocationValid = false;
            if (card) card.className = "p-4 rounded-xl border bg-rose-50 border-rose-300 space-y-2.5";
            if (dot) dot.className = "w-3 h-3 rounded-full bg-rose-500";
            if (title) title.textContent = "Izin Akses Lokasi Ditolak / Tidak Ditemukan";
            if (desc) desc.textContent = "Silakan izinkan akses lokasi (GPS) pada pengaturan browser Anda agar sistem dapat memvalidasi kehadiran Anda di sekolah.";
            if (distVal) distVal.textContent = "Akses Ditolak";
          }
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
      );
    };

    window.toggleGpsDemoMode = function(checked) {
      isGpsDemoMode = checked;
      detectGuruLocation();
      if (checked) {
        showToast("Mode Simulasi GPS diaktifkan untuk pengujian!", "success");
      } else {
        showToast("Mode Ketat GPS diaktifkan (Radius 200m sekolah wajib).", "info");
      }
    };

    // 10.3 KAMERA VERIFIKASI WAJAH (WEBCAM)
    window.startGuruCamera = async function() {
      const video = document.getElementById('guruSelfieVideo');
      const badge = document.getElementById('cameraStatusBadge');
      if (!video) return;

      try {
        if (activeGuruCameraStream) {
          activeGuruCameraStream.getTracks().forEach(t => t.stop());
        }
        activeGuruCameraStream = await navigator.mediaDevices.getUserMedia({
          video: {
            facingMode: 'user',
            width: { ideal: 640 },
            height: { ideal: 480 }
          },
          audio: false
        });
        video.srcObject = activeGuruCameraStream;
        await video.play();

        if (badge) {
          badge.className = "text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 animate-pulse";
          badge.textContent = "Kamera Aktif";
        }
        document.getElementById('btnStartCamera')?.classList.add('hidden');
        document.getElementById('cameraFaceOverlay')?.classList.remove('hidden');
      } catch (err) {
        console.error("Camera access error:", err);
        if (badge) {
          badge.className = "text-[10px] font-bold px-2 py-0.5 rounded bg-rose-100 text-rose-800";
          badge.textContent = "Gagal Membuka Kamera";
        }
        alert("Gagal membuka kamera. Pastikan Anda mengizinkan akses kamera pada browser.");
      }
    };

    window.captureGuruSelfie = function() {
      const video = document.getElementById('guruSelfieVideo');
      const canvas = document.getElementById('guruSelfieCanvas');
      const preview = document.getElementById('guruSelfiePreview');
      const overlay = document.getElementById('cameraFaceOverlay');
      if (!video || !canvas || !preview) return;

      if (!activeGuruCameraStream && (!video.videoWidth || video.videoWidth === 0)) {
        alert("Silakan buka kamera terlebih dahulu sebelum mengambil foto wajah!");
        startGuruCamera();
        return;
      }

      const w = video.videoWidth || 640;
      const h = video.videoHeight || 480;
      canvas.width = w;
      canvas.height = h;

      const ctx = canvas.getContext('2d');
      // Draw captured video frame
      ctx.drawImage(video, 0, 0, w, h);

      // Watermark Overlay bar at bottom
      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
      const dateStr = now.toISOString().substring(0, 10);
      const teacherName = document.getElementById('selfGuruNama')?.textContent || 'Dewan Guru';
      const dist = currentDistanceToSchool !== null ? `${currentDistanceToSchool}m` : 'Sekolah';

      ctx.fillStyle = 'rgba(10, 30, 20, 0.75)';
      ctx.fillRect(0, h - 70, w, 70);

      ctx.fillStyle = '#10b981';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText('SMP ISLAM AL-KHOLILI • VERIFIKASI WAJAH', 16, h - 45);

      ctx.fillStyle = '#ffffff';
      ctx.font = '12px sans-serif';
      ctx.fillText(`${teacherName} | ${dateStr} ${timeStr} WIB`, 16, h - 25);

      ctx.fillStyle = '#a7f3d0';
      ctx.font = '11px monospace';
      ctx.fillText(`GPS: Lokasi Terverifikasi (Jarak: ${dist})`, 16, h - 8);

      // Export base64 data URL
      capturedSelfieDataUrl = canvas.toDataURL('image/jpeg', 0.85);

      preview.src = capturedSelfieDataUrl;
      preview.classList.remove('hidden');
      if (overlay) overlay.classList.add('hidden');
      document.getElementById('btnRetakePhoto')?.classList.remove('hidden');
      document.getElementById('btnCapturePhoto')?.classList.add('hidden');

      showToast("Foto wajah berhasil diambil!");
    };

    window.retakeGuruSelfie = function() {
      capturedSelfieDataUrl = null;
      const preview = document.getElementById('guruSelfiePreview');
      const overlay = document.getElementById('cameraFaceOverlay');
      if (preview) preview.classList.add('hidden');
      if (overlay) overlay.classList.remove('hidden');
      document.getElementById('btnRetakePhoto')?.classList.add('hidden');
      document.getElementById('btnCapturePhoto')?.classList.remove('hidden');
    };

    // 10.4 SUBMIT PRESENSI WAJAH & GPS (MASUK / PULANG)
    window.submitPresensiWajah = async function(type) {
      if (!capturedSelfieDataUrl) {
        alert("Silakan ambil foto wajah (selfie) Anda terlebih dahulu dengan menekan tombol 'Ambil Foto Wajah'!");
        return;
      }

      if (!isLocationValid) {
        alert(`Gagal Melakukan Presensi!\n\nAnda terdeteksi berada di luar lingkungan sekolah (Jarak: ${currentDistanceToSchool || 'Tidak valid'} meter). Sistem presensi wajah hanya mengizinkan absensi di dalam radius 200 meter SMP Islam Al-Kholili.\n\nJika berhalangan hadir, silakan gunakan tab 'Presensi Manual / Izin'.`);
        return;
      }

      const guru = currentTeachers.find(t => String(t.id) === String(activePresensiGuruId));
      if (!guru) {
        alert("Data guru tidak ditemukan!");
        return;
      }

      const now = new Date();
      const today = now.toISOString().substring(0, 10);
      const currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

      let status = "Hadir";
      if (type === 'Masuk') {
        const totalMinutes = now.getHours() * 60 + now.getMinutes();
        if (totalMinutes > 7 * 60) {
          status = "Terlambat";
        }
      }

      const attId = `ATT-G-${today.replace(/-/g, '')}`;
      let attSession = currentTeacherAttendance.find(item => item.id === attId || item.tanggal === today);

      if (!attSession) {
        attSession = {
          id: attId,
          tanggal: today,
          total_guru: currentTeachers.length,
          hadir: 0,
          sakit: 0,
          izin: 0,
          dinas_luar: 0,
          records: [],
          created_at: new Date().toISOString()
        };
        currentTeacherAttendance.unshift(attSession);
      }

      let existingRec = attSession.records.find(r => String(r.guru_id) === String(guru.id));

      if (type === 'Masuk') {
        if (existingRec && existingRec.jam_masuk && existingRec.jam_masuk !== '-') {
          alert(`Anda sudah melakukan absensi masuk hari ini pada pukul ${existingRec.jam_masuk} WIB!`);
          return;
        }

        if (existingRec) {
          existingRec.status = status;
          existingRec.jam_masuk = currentTime;
          existingRec.foto_selfie = capturedSelfieDataUrl;
          existingRec.lat = currentGpsCoords?.lat;
          existingRec.lng = currentGpsCoords?.lng;
          existingRec.jarak_meter = currentDistanceToSchool;
          existingRec.metode = 'Wajah & GPS (Mandiri)';
        } else {
          attSession.records.push({
            guru_id: guru.id,
            nama: guru.nama,
            nip: guru.nip || '-',
            status: status,
            jam_masuk: currentTime,
            jam_pulang: '',
            keterangan: status === 'Terlambat' ? 'Datang terlambat' : 'Tepat waktu',
            foto_selfie: capturedSelfieDataUrl,
            lat: currentGpsCoords?.lat,
            lng: currentGpsCoords?.lng,
            jarak_meter: currentDistanceToSchool,
            metode: 'Wajah & GPS (Mandiri)'
          });
        }
      } else if (type === 'Pulang') {
        if (!existingRec || !existingRec.jam_masuk || existingRec.jam_masuk === '-') {
          alert("Anda belum melakukan absensi masuk hari ini!");
          return;
        }
        existingRec.jam_pulang = currentTime;
        if (!existingRec.foto_selfie) existingRec.foto_selfie = capturedSelfieDataUrl;
      }

      // Recalculate stats
      let h = 0, s = 0, i = 0, d = 0;
      attSession.records.forEach(r => {
        if (r.status === 'Hadir' || r.status === 'Terlambat') h++;
        else if (r.status === 'Sakit') s++;
        else if (r.status === 'Izin') i++;
        else if (r.status === 'Dinas Luar') d++;
      });
      attSession.hadir = h;
      attSession.sakit = s;
      attSession.izin = i;
      attSession.dinas_luar = d;

      try {
        localStorage.setItem('alkholili_attendance_teachers', JSON.stringify(currentTeacherAttendance));
      } catch (e) {}

      // Save to Turso
      await executeTursoSql(
        `INSERT OR REPLACE INTO absen_guru (id, tanggal, total_guru, hadir, sakit, izin, dinas_luar, records, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          { type: "text", value: attSession.id },
          { type: "text", value: attSession.tanggal },
          { type: "integer", value: attSession.total_guru },
          { type: "integer", value: attSession.hadir },
          { type: "integer", value: attSession.sakit },
          { type: "integer", value: attSession.izin },
          { type: "integer", value: attSession.dinas_luar },
          { type: "text", value: JSON.stringify(attSession.records) },
          { type: "text", value: attSession.created_at }
        ]
      );

      showToast(`Presensi ${type} berhasil dikonfirmasi!`, "success");
      updateActiveGuruDisplay(guru);
      renderSelfAttendanceHistory(guru.id);
      retakeGuruSelfie();
    };

    // 10.5 PRESENSI MANUAL OLEH GURU (IZIN / SAKIT / DINAS)
    window.switchPresensiGuruMode = function(mode) {
      const btnWajah = document.getElementById('tabBtnPresensiWajah');
      const btnManual = document.getElementById('tabBtnPresensiManual');
      const containerWajah = document.getElementById('containerPresensiWajah');
      const containerManual = document.getElementById('containerPresensiManual');

      if (!btnWajah || !btnManual || !containerWajah || !containerManual) return;

      if (mode === 'wajah') {
        btnWajah.className = "flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-2 bg-brand-700 text-white shadow-sm";
        btnManual.className = "flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-2 text-slate-600 hover:text-slate-900";
        containerWajah.classList.remove('hidden');
        containerManual.classList.add('hidden');
      } else {
        btnManual.className = "flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-2 bg-brand-700 text-white shadow-sm";
        btnWajah.className = "flex-1 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-2 text-slate-600 hover:text-slate-900";
        containerManual.classList.remove('hidden');
        containerWajah.classList.add('hidden');
      }
    };

