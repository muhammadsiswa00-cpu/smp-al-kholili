    function initStudentAttendanceTab() {
      const today = new Date().toISOString().substring(0, 10);
      const dateInput = document.getElementById('absenSiswaTanggal');
      if (dateInput && !dateInput.value) {
        dateInput.value = today;
      }
      loadStudentAttendanceForDate();
    }

    window.loadStudentAttendanceForDate = function() {
      const date = document.getElementById('absenSiswaTanggal').value;
      const kelas = document.getElementById('absenSiswaKelas').value;
      const container = document.getElementById('studentAttendanceTableBody');
      if (!container) return;

      // Filter siswa di kelas terpilih
      const classStudents = currentStudents.filter(s => s.kelas === kelas && s.status === 'Aktif');
      
      // Cek apakah sudah ada rekap absensi untuk tanggal & kelas ini
      const existing = currentStudentAttendance.find(a => a.tanggal === date && a.kelas === kelas);
      const existingRecords = existing?.records || [];

      if (classStudents.length === 0) {
        container.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">Belum ada data siswa aktif di ${kelas}. Silakan tambahkan siswa di tab Data Siswa.</td></tr>`;
        updateAttendanceStats(0, 0, 0, 0, 0);
        return;
      }

      container.innerHTML = classStudents.map((s, idx) => {
        const rec = existingRecords.find(r => r.student_id === s.id);
        const curStatus = rec ? rec.status : 'H';
        const curKet = rec ? (rec.keterangan || '') : '';

        return `
          <tr class="hover:bg-slate-50 transition" data-student-id="${s.id}">
            <td class="px-4 py-3 text-center font-bold text-slate-400">${idx + 1}</td>
            <td class="px-4 py-3 font-mono font-semibold">${s.nis}</td>
            <td class="px-4 py-3">
              <strong class="text-slate-900">${s.nama}</strong>
            </td>
            <td class="px-4 py-3 text-center font-bold ${s.jenis_kelamin === 'L' ? 'text-blue-600' : 'text-pink-600'}">${s.jenis_kelamin}</td>
            <td class="px-4 py-3 text-center">
              <div class="inline-flex items-center gap-1.5 p-1 bg-slate-100 rounded-xl">
                <label class="px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition ${curStatus === 'H' ? 'bg-emerald-600 text-white' : 'text-slate-600 hover:bg-slate-200'}">
                  <input type="radio" name="att_student_${s.id}" value="H" ${curStatus === 'H' ? 'checked' : ''} onchange="recalculateStudentStats()" class="hidden" /> H
                </label>
                <label class="px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition ${curStatus === 'S' ? 'bg-amber-500 text-white' : 'text-slate-600 hover:bg-slate-200'}">
                  <input type="radio" name="att_student_${s.id}" value="S" ${curStatus === 'S' ? 'checked' : ''} onchange="recalculateStudentStats()" class="hidden" /> S
                </label>
                <label class="px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition ${curStatus === 'I' ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-200'}">
                  <input type="radio" name="att_student_${s.id}" value="I" ${curStatus === 'I' ? 'checked' : ''} onchange="recalculateStudentStats()" class="hidden" /> I
                </label>
                <label class="px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition ${curStatus === 'A' ? 'bg-red-600 text-white' : 'text-slate-600 hover:bg-slate-200'}">
                  <input type="radio" name="att_student_${s.id}" value="A" ${curStatus === 'A' ? 'checked' : ''} onchange="recalculateStudentStats()" class="hidden" /> A
                </label>
              </div>
            </td>
            <td class="px-4 py-3">
              <input type="text" id="att_ket_${s.id}" value="${curKet}" placeholder="Catatan kehadiran (opsional)" class="w-full px-3 py-1.5 rounded-lg border border-slate-200 text-xs focus:ring-1 focus:ring-brand-600 outline-none" />
            </td>
          </tr>
        `;
      }).join('');

      recalculateStudentStats();
    };

    window.setAllStudentsPresent = function() {
      document.querySelectorAll('#studentAttendanceTableBody tr').forEach(row => {
        const studentId = row.dataset.studentId;
        const radioH = row.querySelector(`input[name="att_student_${studentId}"][value="H"]`);
        if (radioH) {
          radioH.checked = true;
          // Update visual classes
          row.querySelectorAll('label').forEach(lbl => {
            lbl.className = "px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition text-slate-600 hover:bg-slate-200";
          });
          radioH.parentElement.className = "px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition bg-emerald-600 text-white";
        }
      });
      recalculateStudentStats();
    };

    window.recalculateStudentStats = function() {
      let total = 0, h = 0, s = 0, i = 0, a = 0;
      document.querySelectorAll('#studentAttendanceTableBody tr').forEach(row => {
        total++;
        const studentId = row.dataset.studentId;
        const checked = row.querySelector(`input[name="att_student_${studentId}"]:checked`);
        const val = checked ? checked.value : 'H';
        if (val === 'H') h++;
        else if (val === 'S') s++;
        else if (val === 'I') i++;
        else if (val === 'A') a++;

        // Visual update
        row.querySelectorAll('label').forEach(lbl => {
          const inp = lbl.querySelector('input');
          if (inp && inp.checked) {
            lbl.className = `px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition text-white ${inp.value === 'H' ? 'bg-emerald-600' : (inp.value === 'S' ? 'bg-amber-500' : (inp.value === 'I' ? 'bg-blue-600' : 'bg-red-600'))}`;
          } else {
            lbl.className = "px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition text-slate-600 hover:bg-slate-200";
          }
        });
      });

      updateAttendanceStats(total, h, s, i, a);
    };

    function updateAttendanceStats(total, h, s, i, a) {
      document.getElementById('statAbsenTotal').textContent = total;
      document.getElementById('statAbsenHadir').textContent = h;
      document.getElementById('statAbsenSakit').textContent = s;
      document.getElementById('statAbsenIzin').textContent = i;
      document.getElementById('statAbsenAlpa').textContent = a;
    }

    window.saveStudentAttendance = async function() {
      const date = document.getElementById('absenSiswaTanggal').value;
      const kelas = document.getElementById('absenSiswaKelas').value;
      const records = [];

      let total = 0, h = 0, s = 0, i = 0, a = 0;
      document.querySelectorAll('#studentAttendanceTableBody tr').forEach(row => {
        total++;
        const sId = Number(row.dataset.studentId);
        const student = currentStudents.find(st => st.id === sId);
        const checked = row.querySelector(`input[name="att_student_${sId}"]:checked`);
        const status = checked ? checked.value : 'H';
        const ket = document.getElementById(`att_ket_${sId}`)?.value.trim() || '';

        if (status === 'H') h++;
        else if (status === 'S') s++;
        else if (status === 'I') i++;
        else if (status === 'A') a++;

        records.push({
          student_id: sId,
          nama: student ? student.nama : '',
          status: status,
          keterangan: ket
        });
      });

      const attId = `ATT-S-${date.replace(/-/g, '')}-${kelas}`;
      const payload = {
        id: attId,
        tanggal: date,
        kelas: kelas,
        total_siswa: total,
        hadir: h,
        sakit: s,
        izin: i,
        alpa: a,
        records: records,
        created_at: new Date().toISOString()
      };

      currentStudentAttendance = currentStudentAttendance.filter(item => item.id !== attId);
      currentStudentAttendance.unshift(payload);

      try {
        localStorage.setItem('alkholili_attendance_students', JSON.stringify(currentStudentAttendance));
      } catch (err) {}

      // Save to Turso
      await executeTursoSql(
        `INSERT OR REPLACE INTO absen_siswa (id, tanggal, kelas, total_siswa, hadir, sakit, izin, alpa, records, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          { type: "text", value: payload.id },
          { type: "text", value: payload.tanggal },
          { type: "text", value: payload.kelas },
          { type: "integer", value: payload.total_siswa },
          { type: "integer", value: payload.hadir },
          { type: "integer", value: payload.sakit },
          { type: "integer", value: payload.izin },
          { type: "integer", value: payload.alpa },
          { type: "text", value: JSON.stringify(payload.records) },
          { type: "text", value: payload.created_at }
        ]
      );

      showToast(`Rekap absensi ${kelas} tanggal ${date} berhasil disimpan!`);
      document.getElementById('metricAbsenSiswa').textContent = currentStudentAttendance.length;
    };

    // ========================================================
    // 10. MANAGE ABSEN GURU
    // ========================================================
    function initTeacherAttendanceTab() {
      const today = new Date().toISOString().substring(0, 10);
      const dateInput = document.getElementById('absenGuruTanggal');
      if (dateInput && !dateInput.value) {
        dateInput.value = today;
      }
      loadTeacherAttendanceForDate();
    }

    window.loadTeacherAttendanceForDate = function() {
      const date = document.getElementById('absenGuruTanggal').value;
      const container = document.getElementById('teacherAttendanceTableBody');
      if (!container) return;

      const existing = currentTeacherAttendance.find(a => a.tanggal === date);
      const existingRecords = existing?.records || [];

      if (currentTeachers.length === 0) {
        container.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">Belum ada data guru. Silakan tambahkan guru di tab Data Guru.</td></tr>`;
        return;
      }

      container.innerHTML = currentTeachers.map((g, idx) => {
        const rec = existingRecords.find(r => String(r.guru_id) === String(g.id));
        const curStatus = rec ? rec.status : 'Hadir';
        const curMasuk = rec ? (rec.jam_masuk || '06:45') : '06:45';
        const curPulang = rec ? (rec.jam_pulang || '14:00') : '14:00';
        const curKet = rec ? (rec.keterangan || '') : '';

        return `
          <tr class="hover:bg-slate-50 transition" data-guru-id="${g.id}">
            <td class="px-4 py-3 text-center font-bold text-slate-400">${idx + 1}</td>
            <td class="px-4 py-3">
              <strong class="text-slate-900 block">${g.nama}</strong>
              <span class="text-[11px] text-slate-500">${g.jabatan || 'Guru'} (${g.mapel || '-'})</span>
            </td>
            <td class="px-4 py-3">
              <select id="att_guru_status_${g.id}" onchange="recalculateTeacherStats()" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs font-bold bg-white focus:ring-1 focus:ring-brand-600">
                <option value="Hadir" ${curStatus === 'Hadir' ? 'selected' : ''}>Hadir (Tepat Waktu)</option>
                <option value="Terlambat" ${curStatus === 'Terlambat' ? 'selected' : ''}>Terlambat</option>
                <option value="Sakit" ${curStatus === 'Sakit' ? 'selected' : ''}>Sakit</option>
                <option value="Izin" ${curStatus === 'Izin' ? 'selected' : ''}>Izin</option>
                <option value="Dinas Luar" ${curStatus === 'Dinas Luar' ? 'selected' : ''}>Dinas Luar / Tugas</option>
              </select>
            </td>
            <td class="px-4 py-3">
              <input type="time" id="att_guru_masuk_${g.id}" value="${curMasuk}" class="w-full px-2 py-1 rounded-lg border border-slate-200 text-xs text-center" />
            </td>
            <td class="px-4 py-3">
              <input type="time" id="att_guru_pulang_${g.id}" value="${curPulang}" class="w-full px-2 py-1 rounded-lg border border-slate-200 text-xs text-center" />
            </td>
            <td class="px-4 py-3">
              <input type="text" id="att_guru_ket_${g.id}" value="${curKet}" placeholder="Keterangan agenda..." class="w-full px-3 py-1.5 rounded-lg border border-slate-200 text-xs" />
            </td>
          </tr>
        `;
      }).join('');

      recalculateTeacherStats();
    };

    window.setAllTeachersPresent = function() {
      currentTeachers.forEach(g => {
        const sel = document.getElementById(`att_guru_status_${g.id}`);
        if (sel) sel.value = "Hadir";
      });
      recalculateTeacherStats();
    };

    window.recalculateTeacherStats = function() {
      let h = 0, s = 0, i = 0, d = 0;
      currentTeachers.forEach(g => {
        const sel = document.getElementById(`att_guru_status_${g.id}`);
        const val = sel ? sel.value : 'Hadir';
        if (val === 'Hadir' || val === 'Terlambat') h++;
        else if (val === 'Sakit') s++;
        else if (val === 'Izin') i++;
        else if (val === 'Dinas Luar') d++;
      });

      document.getElementById('statGuruHadir').textContent = h;
      document.getElementById('statGuruSakit').textContent = s;
      document.getElementById('statGuruIzin').textContent = i;
      document.getElementById('statGuruDinas').textContent = d;
    };

    window.saveTeacherAttendance = async function() {
      const date = document.getElementById('absenGuruTanggal').value;
      const records = [];

      let h = 0, s = 0, i = 0, d = 0;
      currentTeachers.forEach(g => {
        const status = document.getElementById(`att_guru_status_${g.id}`)?.value || 'Hadir';
        const masuk = document.getElementById(`att_guru_masuk_${g.id}`)?.value || '06:45';
        const pulang = document.getElementById(`att_guru_pulang_${g.id}`)?.value || '14:00';
        const ket = document.getElementById(`att_guru_ket_${g.id}`)?.value.trim() || '';

        if (status === 'Hadir' || status === 'Terlambat') h++;
        else if (status === 'Sakit') s++;
        else if (status === 'Izin') i++;
        else if (status === 'Dinas Luar') d++;

        records.push({
          guru_id: g.id,
          nama: g.nama,
          status: status,
          jam_masuk: masuk,
          jam_pulang: pulang,
          keterangan: ket
        });
      });

      const attId = `ATT-G-${date.replace(/-/g, '')}`;
      const payload = {
        id: attId,
        tanggal: date,
        total_guru: currentTeachers.length,
        hadir: h,
        sakit: s,
        izin: i,
        dinas_luar: d,
        records: records,
        created_at: new Date().toISOString()
      };

      currentTeacherAttendance = currentTeacherAttendance.filter(item => item.id !== attId);
      currentTeacherAttendance.unshift(payload);

      try {
        localStorage.setItem('alkholili_attendance_teachers', JSON.stringify(currentTeacherAttendance));
      } catch (err) {}

      // Save to Turso
      await executeTursoSql(
        `INSERT OR REPLACE INTO absen_guru (id, tanggal, total_guru, hadir, sakit, izin, dinas_luar, records, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          { type: "text", value: payload.id },
          { type: "text", value: payload.tanggal },
          { type: "integer", value: payload.total_guru },
          { type: "integer", value: payload.hadir },
          { type: "integer", value: payload.sakit },
          { type: "integer", value: payload.izin },
          { type: "integer", value: payload.dinas_luar },
          { type: "text", value: JSON.stringify(payload.records) },
          { type: "text", value: payload.created_at }
        ]
      );

      showToast(`Absensi guru tanggal ${date} berhasil disimpan!`);
      document.getElementById('metricAbsenGuru').textContent = currentTeacherAttendance.length;
    };

    // ========================================================
    // 11. MANAGE DEWAN GURU & FOTO
    // ========================================================
    function renderTeachers() {
      const container = document.getElementById('teachersTableBody');
      if (!container) return;
      container.innerHTML = currentTeachers.map(t => `
        <tr class="hover:bg-slate-50 transition">
          <td class="px-4 py-3">
            <div class="w-10 h-10 rounded-xl overflow-hidden bg-white shadow border border-slate-200">
              <img src="${t.foto || '/assets/img/teachers/male-1.svg'}" class="w-full h-full object-cover" />
            </div>
          </td>
          <td class="px-4 py-3 font-semibold text-slate-800">${t.nama}</td>
          <td class="px-4 py-3">${t.jabatan || '-'}</td>
          <td class="px-4 py-3">${t.mapel || '-'}</td>
          <td class="px-4 py-3 text-slate-500">${t.pendidikan || '-'}</td>
          <td class="px-4 py-3 text-center space-x-1">
            <button type="button" onclick="editGuru(${t.id})" class="p-1.5 text-brand-700 hover:bg-brand-50 rounded-lg transition" title="Edit">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button type="button" onclick="deleteGuru(${t.id})" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition" title="Hapus">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </td>
        </tr>
      `).join('');
      document.getElementById('metricGuru').textContent = currentTeachers.length;
    }

    window.editGuru = function(id) {
      const t = currentTeachers.find(item => item.id === id);
      if (!t) return;
      document.getElementById('guruEditId').value = t.id;
      document.getElementById('guruNama').value = t.nama;
      document.getElementById('guruJabatan').value = t.jabatan || '';
      document.getElementById('guruMapel').value = t.mapel || '';
      document.getElementById('guruPendidikan').value = t.pendidikan || '';
      document.getElementById('teacherPhotoVal').value = t.foto || '/assets/img/teachers/male-1.svg';
      document.getElementById('teacherPhotoPreview').src = t.foto || '/assets/img/teachers/male-1.svg';

      document.getElementById('btnSubmitGuru').innerHTML = `<i class="fa-solid fa-floppy-disk"></i> <span>Perbarui Data Guru</span>`;
      document.getElementById('btnCancelGuruEdit').classList.remove('hidden');
      window.scrollTo({ top: document.getElementById('formGuru').offsetTop - 60, behavior: 'smooth' });
    };

    window.cancelGuruEdit = function() {
      document.getElementById('formGuru').reset();
      document.getElementById('guruEditId').value = '';
      document.getElementById('teacherPhotoVal').value = '/assets/img/teachers/male-1.svg';
      document.getElementById('teacherPhotoPreview').src = '/assets/img/teachers/male-1.svg';
      document.getElementById('btnSubmitGuru').innerHTML = `<i class="fa-solid fa-user-plus"></i> <span>Simpan Data Guru</span>`;
      document.getElementById('btnCancelGuruEdit').classList.add('hidden');
    };

    window.deleteGuru = async function(id) {
      if (!confirm('Yakin ingin menghapus guru ini?')) return;
      currentTeachers = currentTeachers.filter(t => t.id !== id);
      renderTeachers();
      await executeTursoSql(`DELETE FROM guru WHERE id = ?`, [{ type: "text", value: String(id) }]);
      showToast("Data guru berhasil dihapus!");
    };

    // Teacher photo file change
    document.getElementById('inputTeacherPhotoFile')?.addEventListener('change', async function(e) {
      const file = e.target.files[0];
      if (file) {
        const dataUrl = await fileToDataUrl(file, 600);
        document.getElementById('teacherPhotoPreview').src = dataUrl;
        document.getElementById('teacherPhotoVal').value = dataUrl;
      }
    });

    document.getElementById('formGuru')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = document.getElementById('guruEditId').value;
      const id = editId ? Number(editId) : Date.now();
      const nama = document.getElementById('guruNama').value.trim();
      const jabatan = document.getElementById('guruJabatan').value.trim();
      const mapel = document.getElementById('guruMapel').value.trim();
      const pendidikan = document.getElementById('guruPendidikan').value.trim();
      const foto = document.getElementById('teacherPhotoVal').value;

      const teacherObj = { id, nama, jabatan, mapel, pendidikan, foto };

      if (editId) {
        currentTeachers = currentTeachers.map(t => t.id === Number(editId) ? teacherObj : t);
      } else {
        currentTeachers.push(teacherObj);
      }
      renderTeachers();
      cancelGuruEdit();

      await executeTursoSql(
        `INSERT OR REPLACE INTO guru (id, nama, jabatan, mapel, pendidikan, foto) VALUES (?, ?, ?, ?, ?, ?)`,
        [
          { type: "text", value: String(id) },
          { type: "text", value: nama },
          { type: "text", value: jabatan },
          { type: "text", value: mapel },
          { type: "text", value: pendidikan },
          { type: "text", value: foto }
        ]
      );
      showToast("Data guru berhasil disimpan!");
    });

    // ========================================================
    // 12. MANAGE GALERI FOTO
    // ========================================================
    function renderGallery() {
      const container = document.getElementById('galleryGrid');
      if (!container) return;
      container.innerHTML = currentGallery.map(g => `
        <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 group relative">
          <div class="h-36 bg-slate-800 overflow-hidden relative">
            <img src="${g.gambar || g.foto}" class="w-full h-full object-cover group-hover:scale-105 transition" />
            <span class="absolute top-2 left-2 px-2 py-0.5 rounded text-[10px] font-bold bg-brand-900/80 text-white backdrop-blur-sm">
              ${g.kategori_label || g.kategori}
            </span>
          </div>
          <div class="p-3.5 space-y-1">
            <h4 class="font-bold text-slate-800 text-xs truncate">${g.judul}</h4>
            <p class="text-[11px] text-slate-500 line-clamp-1">${g.deskripsi || ''}</p>
            <div class="pt-2 flex justify-end">
              <button type="button" onclick="deleteGaleri(${g.id})" class="text-xs text-red-600 hover:text-red-700 font-bold inline-flex items-center gap-1">
                <i class="fa-solid fa-trash-can text-[10px]"></i> Hapus
              </button>
            </div>
          </div>
        </div>
      `).join('');
      document.getElementById('metricGaleri').textContent = currentGallery.length;
    }

    window.deleteGaleri = async function(id) {
      if (!confirm('Hapus foto ini dari galeri?')) return;
      currentGallery = currentGallery.filter(g => g.id !== id);
      renderGallery();
      await executeTursoSql(`DELETE FROM galeri WHERE id = ?`, [{ type: "text", value: String(id) }]);
      showToast("Foto galeri berhasil dihapus!");
    };

    document.getElementById('inputGaleriPhotoFile')?.addEventListener('change', async function(e) {
      const file = e.target.files[0];
      if (file) {
        const dataUrl = await fileToDataUrl(file, 900);
        document.getElementById('galeriPhotoPreview').src = dataUrl;
        document.getElementById('galeriPhotoVal').value = dataUrl;
      }
    });

    document.getElementById('formGaleri')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = Date.now();
      const judul = document.getElementById('galeriJudul').value.trim();
      const kategori = document.getElementById('galeriKategori').value;
      const deskripsi = document.getElementById('galeriDeskripsi').value.trim();
      const foto = document.getElementById('galeriPhotoVal').value || '/assets/img/hero-bg.svg';

      const katLabels = {
        ibadah: 'Keagamaan & Ibadah',
        tahfidz: 'Tahfidz Qur\'an',
        belajar: 'Belajar Mengajar',
        ekskul: 'Ekstrakurikuler',
        fasilitas: 'Sarana & Fasilitas'
      };

      const newGal = {
        id,
        judul,
        kategori,
        kategori_label: katLabels[kategori] || 'Kegiatan',
        gambar: foto,
        foto: foto,
        deskripsi: deskripsi
      };

      currentGallery.unshift(newGal);
      renderGallery();
      document.getElementById('formGaleri').reset();
      document.getElementById('galeriPhotoPreview').src = '/assets/img/hero-bg.svg';
      document.getElementById('galeriPhotoVal').value = '';

      await executeTursoSql(
        `INSERT INTO galeri (id, judul, kategori, gambar, deskripsi) VALUES (?, ?, ?, ?, ?)`,
        [
          { type: "text", value: String(id) },
          { type: "text", value: judul },
          { type: "text", value: kategori },
          { type: "text", value: foto },
          { type: "text", value: deskripsi }
        ]
      );
      showToast("Foto berhasil ditambahkan ke galeri!");
    });

    // ========================================================
    // 13. MANAGE BERITA SEKOLAH
    // ========================================================
    function renderNews() {
      const container = document.getElementById('newsList');
      if (!container) return;
      container.innerHTML = currentNews.map(n => `
        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50 flex items-start justify-between gap-4">
          <div class="space-y-1">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${n.badge || 'bg-emerald-100 text-emerald-800'}">
              ${n.kategori || 'Berita'}
            </span>
            <h4 class="font-bold text-slate-800 text-sm">${n.judul}</h4>
            <p class="text-xs text-slate-500 line-clamp-2">${n.ringkasan || n.konten || ''}</p>
            <span class="text-[10px] text-slate-400 block">${n.tanggal || ''}</span>
          </div>
          <button type="button" onclick="deleteBerita(${n.id})" class="text-red-600 hover:text-red-700 p-1.5 text-xs">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      `).join('');
      document.getElementById('metricBerita').textContent = currentNews.length;
    }

    window.deleteBerita = async function(id) {
      if (!confirm('Hapus berita ini?')) return;
      currentNews = currentNews.filter(n => n.id !== id);
      renderNews();
      await executeTursoSql(`DELETE FROM berita WHERE id = ?`, [{ type: "text", value: String(id) }]);
      showToast("Berita berhasil dihapus!");
    };

    document.getElementById('formBerita')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = Date.now();
      const judul = document.getElementById('beritaJudul').value.trim();
      const kategori = document.getElementById('beritaKategori').value;
      const ringkasan = document.getElementById('beritaRingkasan').value.trim();

      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      const tanggal = new Date().toLocaleDateString('id-ID', options);

      const newItem = {
        id,
        judul,
        kategori,
        ringkasan,
        konten: ringkasan,
        tanggal,
        penulis: "Humas Sekolah",
        badge: kategori.includes('PPDB') ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'
      };

      currentNews.unshift(newItem);
      renderNews();
      document.getElementById('formBerita').reset();

      await executeTursoSql(
        `INSERT INTO berita (id, judul, kategori, tanggal, penulis, ringkasan) VALUES (?, ?, ?, ?, ?, ?)`,
        [
          { type: "text", value: String(id) },
          { type: "text", value: judul },
          { type: "text", value: kategori },
          { type: "text", value: tanggal },
          { type: "text", value: newItem.penulis },
          { type: "text", value: ringkasan }
        ]
      );
      showToast("Berita berhasil diterbitkan!");
    });

    // ========================================================
    // 14. PENGATURAN WEBSITE
    // ========================================================
    document.getElementById('inputLogoFile')?.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        const url = await fileToDataUrl(file, 400);
        document.getElementById('previewLogo').src = url;
        document.getElementById('settingLogoVal').value = url;
      }
    });

    document.getElementById('inputHeroBgFile')?.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        const url = await fileToDataUrl(file, 1200);
        document.getElementById('previewHeroBg').src = url;
        document.getElementById('settingHeroBgVal').value = url;
      }
    });

    document.getElementById('inputKepsekFile')?.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        const url = await fileToDataUrl(file, 600);
        document.getElementById('previewKepsek').src = url;
        document.getElementById('settingKepsekFotoVal').value = url;
      }
    });

    document.getElementById('formPengaturan')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const updated = {
        site_name: document.getElementById('settingSiteName').value.trim(),
        site_tagline: document.getElementById('settingSiteTagline').value.trim(),
        hero_title: document.getElementById('settingHeroTitle').value.trim(),
        hero_subtitle: document.getElementById('settingHeroSubtitle').value.trim(),
        nama_kepsek: document.getElementById('settingNamaKepsek').value.trim(),
        ppdb_url: document.getElementById('settingPpdbUrl').value.trim(),
        whatsapp_number: document.getElementById('settingWaNum').value.trim(),
        whatsapp_display: document.getElementById('settingWaDisplay').value.trim(),
        alamat: document.getElementById('settingAlamat').value.trim(),
        logo: document.getElementById('settingLogoVal').value,
        hero_bg: document.getElementById('settingHeroBgVal').value,
        kepsek_foto: document.getElementById('settingKepsekFotoVal').value
      };

      await executeTursoSql(
        `UPDATE pengaturan SET site_name = ?, site_tagline = ?, hero_title = ?, hero_subtitle = ?, alamat = ?, whatsapp_number = ?, whatsapp_display = ?, ppdb_url = ?, logo = ?, hero_bg = ?, nama_kepsek = ?, kepsek_foto = ? WHERE id = 1`,
        [
          { type: "text", value: updated.site_name },
          { type: "text", value: updated.site_tagline },
          { type: "text", value: updated.hero_title },
          { type: "text", value: updated.hero_subtitle },
          { type: "text", value: updated.alamat },
          { type: "text", value: updated.whatsapp_number },
          { type: "text", value: updated.whatsapp_display },
          { type: "text", value: updated.ppdb_url },
          { type: "text", value: updated.logo },
          { type: "text", value: updated.hero_bg },
          { type: "text", value: updated.nama_kepsek },
          { type: "text", value: updated.kepsek_foto }
        ]
      );
      showToast("Pengaturan website berhasil disimpan ke database!");
    });

    function renderAll() {
      renderPpdb();
      renderStudents();
      renderTeachers();
      renderGallery();
      renderNews();
    }

    // Init on page load
    checkAuth();
  </script>
</body>
</html>
