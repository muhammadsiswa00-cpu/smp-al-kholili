    function renderStudents() {
      const container = document.getElementById('studentTableBody');
      if (!container) return;

      const search = (document.getElementById('searchStudentInput')?.value || '').toLowerCase();
      const kelasFilter = document.getElementById('filterStudentKelas')?.value || 'all';
      const statusFilter = document.getElementById('filterStudentStatus')?.value || 'all';

      const filtered = currentStudents.filter(s => {
        const matchSearch = (s.nama || '').toLowerCase().includes(search) ||
                            (s.nis || '').toLowerCase().includes(search) ||
                            (s.nisn || '').toLowerCase().includes(search);
        const matchKelas = kelasFilter === 'all' || s.kelas === kelasFilter;
        const matchStatus = statusFilter === 'all' || s.status === statusFilter;
        return matchSearch && matchKelas && matchStatus;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<tr><td colspan="8" class="px-4 py-8 text-center text-slate-400">Tidak ada data siswa yang cocok.</td></tr>`;
      } else {
        container.innerHTML = filtered.map(s => `
          <tr class="hover:bg-slate-50 transition">
            <td class="px-4 py-3 font-mono">
              <strong class="text-slate-900 block">${s.nis || '-'}</strong>
              <span class="text-[10px] text-slate-400">${s.nisn || '-'}</span>
            </td>
            <td class="px-4 py-3">
              <strong class="text-slate-900 block">${s.nama || '-'}</strong>
              <span class="text-[10px] text-slate-400">${s.tempat_lahir || ''}, ${s.tanggal_lahir || ''}</span>
            </td>
            <td class="px-4 py-3 font-bold text-brand-800">${s.kelas || '-'}</td>
            <td class="px-4 py-3 text-center">
              <span class="px-2 py-0.5 rounded font-bold ${s.jenis_kelamin === 'L' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800'}">${s.jenis_kelamin || 'L'}</span>
            </td>
            <td class="px-4 py-3">
              <span class="text-slate-800 block">${s.nama_ortu || '-'}</span>
              <span class="text-[10px] text-slate-500 font-mono">${s.telepon_ortu || '-'}</span>
            </td>
            <td class="px-4 py-3 text-slate-600 max-w-xs truncate">${s.alamat || '-'}</td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${s.status === 'Aktif' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700'}">${s.status || 'Aktif'}</span>
            </td>
            <td class="px-4 py-3 text-center space-x-1">
              <button type="button" onclick="editStudent(${s.id})" class="p-1.5 text-brand-700 hover:bg-brand-50 rounded-lg transition" title="Edit">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              <button type="button" onclick="deleteStudent(${s.id})" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition" title="Hapus">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </td>
          </tr>
        `).join('');
      }

      document.getElementById('metricSiswa').textContent = currentStudents.length;
    }

