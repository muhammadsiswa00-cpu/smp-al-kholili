    window.savePpdbStatus = async function() {
      if (!selectedPpdbItem) return;
      const newStatus = document.getElementById('modalUpdateStatus').value;
      selectedPpdbItem.status = newStatus;

      // Update in LocalStorage
      try {
        localStorage.setItem('alkholili_ppdb_submissions', JSON.stringify(currentPpdb));
      } catch (e) {}

      // Update in Turso
      await executeTursoSql(
        `UPDATE ppdb SET status = ? WHERE id = ? OR no_pendaftaran = ?`,
        [
          { type: "text", value: newStatus },
          { type: "text", value: selectedPpdbItem.id },
          { type: "text", value: selectedPpdbItem.id }
        ]
      );

      showToast(`Status pendaftaran ${selectedPpdbItem.nama || selectedPpdbItem.nama_lengkap} diubah menjadi '${newStatus}'!`);
