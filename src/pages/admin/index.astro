      currentPpdb = currentPpdb.filter(p => p.id !== id && p.no_pendaftaran !== id);
      try {
        localStorage.setItem('alkholili_ppdb_submissions', JSON.stringify(currentPpdb));
      } catch (e) {}

      await executeTursoSql(`DELETE FROM ppdb WHERE id = ? OR no_pendaftaran = ?`, [
        { type: "text", value: String(id) },
        { type: "text", value: String(id) }
      ]);

      showToast("Data pendaftar berhasil dihapus!");
