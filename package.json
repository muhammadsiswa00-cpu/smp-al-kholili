{
  "name": "smp-islam-al-kholili",
  "type": "module",
  "version": "1.0.0",
  "description": "Website Resmi SMP Islam Al-Kholili Kota Probolinggo berbasis Astro & Turso",
  "scripts": {
    "dev": "set ASTRO_TELEMETRY_DISABLED=1&& astro dev",
    "start": "set ASTRO_TELEMETRY_DISABLED=1&& astro dev",
    "build": "set ASTRO_TELEMETRY_DISABLED=1&& astro build",
    "preview": "set ASTRO_TELEMETRY_DISABLED=1&& astro preview",
    "astro": "set ASTRO_TELEMETRY_DISABLED=1&& astro"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "@libsql/client": "^0.18.0",
    "astro": "^4.10.0",
    "tailwindcss": "^3.4.4"
  }
}
